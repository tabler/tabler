---
import Subheader from '@ui/Subheader.astro'
import Chart from '@shared/components/demo/Chart.astro'
import Trending from '@ui/Trending.astro'
---

<div class="card">
  <div class="card-body">
    <Subheader>Total Users</Subheader>
    <div class="d-flex align-items-baseline">
      <div class="h1 mb-0 me-2">75,782</div>
      <div class="me-auto">
        <Trending value={2} />
      </div>
    </div>
    <div class="text-secondary mt-2">24,635 users increased from last month</div>
  </div>
  <Chart chartId="visitors" height={6} label="Total users" />
</div>
