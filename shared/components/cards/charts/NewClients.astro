---
import Subheader from '@ui/Subheader.astro'
import Chart from '@shared/components/demo/Chart.astro'
import DropdownDays from '@shared/components/demo/DropdownDays.astro'
import Trending from '@ui/Trending.astro'
---

<div class="card">
  <div class="card-body">
    <div class="d-flex align-items-center">
      <Subheader>New clients</Subheader>
      <div class="ms-auto lh-1">
        <DropdownDays id="new-clients" label="Select time range for new clients" />
      </div>
    </div>
    <div class="d-flex align-items-baseline">
      <div class="h1 mb-3 me-2">6,782</div>
      <div class="me-auto">
        <Trending value={0} />
      </div>
    </div>

    <Chart chartId="new-clients" size="sm" label="New clients" />
  </div>
</div>
