---
// legend=true at call site is inert — Chart reads legend from chart data, not props.
import CardTitle from '@ui/CardTitle.astro'
import Chart from '@shared/components/demo/Chart.astro'
import DropdownDays from '@shared/components/demo/DropdownDays.astro'
---

<div class="card">
  <div class="card-body">
    <div class="d-flex">
      <CardTitle>Social referrals</CardTitle>
      <div class="ms-auto">
        <DropdownDays id="social-referrals" label="Select time range for sales data" />
      </div>
    </div>
    <Chart chartId="social-referrals" label="Social referrals" />
  </div>
</div>
