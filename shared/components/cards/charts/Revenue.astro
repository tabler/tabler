---
import Subheader from '@ui/Subheader.astro'
import Chart from '@shared/components/demo/Chart.astro'
import DropdownDays from '@shared/components/demo/DropdownDays.astro'
import Trending from '@ui/Trending.astro'
---

<div class="card">
  <div class="card-body">
    <div class="d-flex align-items-center">
      <Subheader>Revenue</Subheader>
      <div class="ms-auto lh-1">
        <DropdownDays id="revenue" label="Select time range for revenue" />
      </div>
    </div>
    <div class="d-flex align-items-baseline">
      <div class="h1 mb-0 me-2">$4,300</div>
      <div class="me-auto">
        <Trending value={8} />
      </div>
    </div>
  </div>
  <Chart chartId="revenue-bg" size="sm" class="rounded-bottom-3" label="Revenue" />
</div>
