---
import Button from '@ui/Button.astro';
import HrText from '@ui/HrText.astro';
import SignInForm from './SignInForm.astro';
---

<div class="card card-md">
	<div class="card-body">
		<h2 class="h2 text-center mb-4">Login to your account</h2>

		<SignInForm />
	</div>

	<HrText text="or" />

	<div class="card-body">
		<div class="row">
			<div class="col">
				<Button block icon="brand-github" iconColor="github" text="Login with Github" />
			</div>
			<div class="col">
				<Button block icon="brand-x" iconColor="x" text="Login with X" />
			</div>
		</div>
	</div>
</div>

<div class="text-center text-secondary mt-3">
	Don't have account yet? <a href="./sign-up.html" tabindex="-1">Sign up</a>
</div>
