---
import Avatar from '@ui/Avatar.astro'
import { people } from '@shared/lib/people'
import CardDropdown from '@ui/CardDropdown.astro'
import { requireIndex } from '@shared/lib/array'
import CardTitle from '@ui/CardTitle.astro'

interface Props {
  personId?: number
}

const { personId = 0 } = Astro.props
const person = requireIndex(people, personId)
---

<div class="card">
  <div class="card-body">
    <div class="row g-2 align-items-center">
      <div class="col-auto">
        <Avatar person={person} size="lg" />
      </div>
      <div class="col">
        <CardTitle class="m-0">
          <a href="#">{person.full_name}</a>
        </CardTitle>
        <div class="text-secondary">
          Working in {person.company}
        </div>
        <div class="small mt-1">
          <span class="badge bg-green"></span> Online
        </div>
      </div>
      <div class="col-auto">
        <a href="#" class="btn"> Subscribe </a>
      </div>
      <div class="col-auto">
        <CardDropdown />
      </div>
    </div>
  </div>
</div>
