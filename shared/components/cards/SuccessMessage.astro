---
import Icon from '@ui/Icon.astro'
import Button from '@ui/Button.astro'
import ButtonList from '@ui/ButtonList.astro'
import CardTitle from '@ui/CardTitle.astro'
---

<div class="card card-gradient card-gradient-success">
  <div class="card-body p-5 text-center">
    <div class="mb-3">
      <Icon name="circle-check" class="icon-lg" color="success" />
    </div>
    <CardTitle>Success!</CardTitle>
    <p class="text-secondary">Your changes have been saved successfully.</p>

    <ButtonList center class="mt-5">
      <Button text="Continue" color="success" />
    </ButtonList>
  </div>
</div>
