---
import MapVector from '@ui/MapVector.astro'

interface Props {
  title?: string
}

const { title } = Astro.props
const map = 'world'
---

<div class="card">
  <div class="card-body">
    {title && <h3 class="card-title">{title}</h3>}
    <MapVector mapId={map} color="primary" ratio="21x9" />
  </div>
</div>
