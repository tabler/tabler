---
import MapVector from '@ui/MapVector.astro'
import CardTitle from '@ui/CardTitle.astro'

interface Props {
  title?: string
}

const { title } = Astro.props
const map = 'world'
---

<div class="card">
  <div class="card-body">
    {title && <CardTitle>{title}</CardTitle>}
    <MapVector mapId={map} color="primary" ratio="21x9" />
  </div>
</div>
