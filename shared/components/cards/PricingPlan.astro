---
import Button from '@ui/Button.astro'
import IconList from '@ui/IconList.astro'
import IconListItem from '@ui/IconListItem.astro'
---

<div class="card card-gradient card-gradient-love">
  <div class="ribbon bg-pink">Featured</div>
  <div class="card-body">
    <div class="subheader text-pink">Professional</div>
    <div class="d-flex align-items-baseline mt-5">
      <div class="display-5">$199</div>
      <div class="fs-1 text-secondary">/ month</div>
    </div>
    <IconList color="success" class="mt-6">
      <IconListItem>
        <span><strong>Unlimited</strong> Target Audience</span>
      </IconListItem>
      <IconListItem>
        <span><strong>1</strong> User Account</span>
      </IconListItem>
      <IconListItem>
        <span><strong>100+</strong> Video Tuts</span>
      </IconListItem>
      <IconListItem icon="x" color="secondary" class="text-secondary">Public Displays</IconListItem>
    </IconList>
    <p class="mt-4 text-muted">This plan is perfect for small businesses and startups. It includes all the features you need to get started.</p>
    <div class="mt-6">
      <Button text="Purchase Now" color="pink" block />
    </div>
  </div>
</div>
