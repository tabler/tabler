---
// MapLibre GL map on OpenFreeMap tiles: no account and no access token.
// The map follows the page theme: `style` in light mode, `darkStyle` in dark.
// With <MapPalette /> on the page, the default styles get softer colors.
// Markers written in HTML go in the default slot: each child has `data-lng`
// and `data-lat`, holds the marker element, and optionally a `<template>` with
// the popup content. Renders nothing unless maps[mapId] exists or `center` is set.
import maps from '@data/maps.json';
import CaptureScript from '../CaptureScript.astro';

interface Props {
	/** Key into the maps data; also the suffix of the container id */
	mapId: string;
	ratio?: string;
	/** for a map with no entry in the maps data: [latitude, longitude] */
	center?: [number, number];
	zoom?: number;
	title?: string;
	style?: string;
	controls?: boolean;
	/** draws the map as a 3D globe instead of a flat map */
	globe?: boolean;
	/** rounded corners; turn off when the map fills a box that has its own corners */
	rounded?: boolean;
	/** fixed height (any CSS length) instead of an aspect ratio */
	height?: string;
}

const { mapId, ratio, center: centerProp, zoom: zoomProp, title, style: styleProp, controls: controlsProp, globe = false, rounded = true, height } = Astro.props;

type MapData = {
	title?: string | undefined;
	ratio?: string;
	card?: boolean;
	/** OpenFreeMap style name: positron (default), liberty, bright, dark or fiord */
	style?: string | undefined;
	/** style used in dark mode, `dark` by default */
	darkStyle?: string;
	/** adds the zoom and compass buttons */
	controls?: boolean | undefined;
	zoom?: number | undefined;
	center?: [number, number];
	markers?: { name?: string; center: [number, number] }[];
};

const data: MapData | undefined = (maps as unknown as Record<string, MapData>)[mapId] ?? (centerProp ? { title, center: centerProp, zoom: zoomProp, style: styleProp, controls: controlsProp } : undefined);
const hasHtmlMarkers = Astro.slots.has('default');

const mapContainerId = `map-${mapId}`;
const styleUrl = (name: string) => `https://tiles.openfreemap.org/styles/${name}`;
const style = styleUrl(data?.style ?? 'positron');
const darkStyle = styleUrl(data?.darkStyle ?? 'dark');
// The softer palette (MapPalette.astro) is made for these two styles only
const palette = { light: !data?.style || data.style === 'positron', dark: !data?.darkStyle || data.darkStyle === 'dark' };
const controls = data?.controls ?? false;
const zoom = data?.zoom ?? 13;
const center = data?.center ? [data.center[1], data.center[0]] : [13.4049, 52.518827];
const markers = (data?.markers ?? []).map((marker) => ({ name: marker.name, coords: [marker.center[1], marker.center[0]] }));

const ratioClass = data?.ratio ?? ratio ?? '16x9';
---

{
	data && (
		<div class:list={height ? 'position-relative' : `ratio ratio-${ratioClass}`} style={height ? `height: ${height}` : undefined}>
			<div class:list={[height && 'h-100']}>
				<div id={mapContainerId} class:list={['w-100 h-100', rounded && 'rounded']} role="img" aria-label={data.title ?? 'Map'} />
				<slot name="overlay" />
			</div>
		</div>
	)
}
{
	data && hasHtmlMarkers && (
		<div id={`${mapContainerId}-markers`} hidden>
			<slot />
		</div>
	)
}
{
	data && (
		<CaptureScript>
			<!-- BEGIN MAP -->
			<script is:inline define:vars={{ mapContainerId, style, darkStyle, palette, controls, globe, zoom, center, markers }}>
				window.tabler_map ??= {};

				function initMap() {
					const theme = () => (document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light');
					const themeStyle = () => (theme() === 'dark' ? darkStyle : style);

					const map = new maplibregl.Map({
						container: mapContainerId,
						style: themeStyle(),
						zoom,
						center,
					});

					// Softer map colors, when the page has the palette script
					map.on('style.load', () => {
						if (window.tablerMapPalette && palette[theme()]) {
							window.tablerMapPalette(map, theme());
						}
					});

					if (controls) {
						map.addControl(new maplibregl.NavigationControl());
					}

					if (globe) {
						// The projection is part of the style, so set it again each time the style loads
						map.on('style.load', () => map.setProjection({ type: 'globe' }));
					}

					markers.forEach((marker) => {
						const element = document.createElement('span');

						element.className = 'map-marker map-marker-dot';
						new maplibregl.Marker({ element }).setLngLat(marker.coords).setPopup(new maplibregl.Popup({ offset: 16, closeButton: false }).setText(marker.name)).addTo(map);
					});

					// Markers written in HTML: the first child is the marker, a <template> is its popup
					document.querySelectorAll(`#${mapContainerId}-markers > [data-lng]`).forEach((item) => {
						const anchor = item.dataset.anchor ?? 'center';
						const marker = new maplibregl.Marker({ element: item.firstElementChild, anchor, draggable: 'draggable' in item.dataset });
						const popup = item.querySelector('template');

						if (popup) {
							marker.setPopup(new maplibregl.Popup({ offset: anchor === 'bottom' ? 40 : 16, className: popup.className, maxWidth: 'none', focusAfterOpen: !('open' in item.dataset) }).setDOMContent(popup.content));
						}

						marker.setLngLat([Number(item.dataset.lng), Number(item.dataset.lat)]).addTo(map);

						if (popup && 'open' in item.dataset) {
							marker.togglePopup();
						}
					});

					// Change the map style when the page theme changes
					new MutationObserver(() => map.setStyle(themeStyle())).observe(document.documentElement, { attributeFilter: ['data-bs-theme'] });

					window.tabler_map[mapContainerId] = map;
				}

				document.readyState !== 'loading' ? initMap() : document.addEventListener('DOMContentLoaded', initMap, { once: true });
			</script>
			<!-- END MAP -->
		</CaptureScript>
	)
}
