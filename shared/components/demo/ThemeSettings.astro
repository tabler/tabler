---
// Offcanvas behavior script lives in BaseLayout (after global scripts).
import FormHint from '@ui/FormHint.astro'
import Icon from '@ui/Icon.astro'
import Subheader from '@ui/Subheader.astro'
import { themeDefaults, themeSections } from '@shared/lib/theme-config'
---

<!-- BEGIN THEME SETTINGS -->
<div class="settings">
  <button type="button" class="btn btn-floating btn-icon btn-primary" data-bs-toggle="offcanvas" data-bs-target="#offcanvas-settings" aria-controls="offcanvas-settings" aria-label="Theme Settings">
    <Icon name="brush" />
  </button>

  <form class="offcanvas offcanvas-start offcanvas-narrow" tabindex="-1" id="offcanvas-settings" role="dialog" aria-modal="true" aria-labelledby="offcanvas-settings-title">
    <div class="offcanvas-header">
      <h2 class="offcanvas-title" id="offcanvas-settings-title">Theme Settings</h2>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
      <div>
        {
          themeSections.map((section) => (
            <Fragment>
              <Subheader class="mb-3">{section.title}</Subheader>

              {section.settings.map((setting) => (
                <fieldset class="border-0 p-0 mb-4" data-theme-setting={setting.key} data-theme-sidebar-only={setting.sidebarOnly ? '' : undefined}>
                  <legend class="form-label float-none mb-0" style="font-size: inherit;">
                    {setting.legend}
                  </legend>
                  <FormHint as="p">{setting.hint}</FormHint>

                  {setting.control === 'color' ? (
                    <div class="row g-2">
                      {setting.options.map((option) => (
                        <div class="col-auto">
                          <label class="form-colorinput">
                            <input type="radio" name={setting.key} value={option.value} class="form-colorinput-input" checked={option.value === themeDefaults[setting.key]} aria-label={option.label} />
                            <span class={`form-colorinput-color bg-${option.value}`} />
                          </label>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div>
                      {setting.options.map((option) => (
                        <label class="form-check">
                          <div class="form-selectgroup-item">
                            <input type="radio" name={setting.key} value={option.value} class="form-check-input" checked={option.value === themeDefaults[setting.key]} />
                            <div class="form-check-label">{option.label}</div>
                          </div>
                        </label>
                      ))}
                    </div>
                  )}
                </fieldset>
              ))}
            </Fragment>
          ))
        }
      </div>

      <div class="mt-auto space-y">
        <button type="button" class="btn w-100" id="reset-changes">
          <Icon name="rotate" />
          Reset changes
        </button>
        <button type="button" class="btn btn-primary w-100" data-bs-dismiss="offcanvas">Save</button>
      </div>
    </div>
  </form>
</div>
<!-- END THEME SETTINGS -->
