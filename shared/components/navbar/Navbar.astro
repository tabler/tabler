---
// Condensed and non-condensed navbar branches. DefaultLayout passes condensed,
// overlap, dark, hideBrand, sticky, transparent, class, hideSearch; navigation
// showcase pages also use sample, personId, hideLogo, smallLogo, showTitle,
// hideIcons, hideUsername, background, backgroundColor, fluidSearch.
//
// fluidSearch has no effect on output (search in the condensed branch is dead
// code); the prop is kept for call-site compatibility.
import Icon from '@ui/Icon.astro';
import Logo from './Logo.astro';
import NavbarToggler from './NavbarToggler.astro';
import NavbarSide from './NavbarSide.astro';
import NavbarMenu from './NavbarMenu.astro';
import NavbarSearch from './NavbarSearch.astro';

interface Props {
	hideSearch?: boolean;
	/** equivalent of the page-menu front matter (active menu entry), e.g. "dashboards.default" */
	pageMenu?: string;
	breakpoint?: string;
	condensed?: boolean;
	dark?: boolean;
	transparent?: boolean;
	overlap?: boolean;
	sticky?: boolean;
	hideBrand?: boolean;
	/** use the sample menu (menu-sample.json) instead of the real one */
	sample?: boolean;
	/** 1-based index into people.json for the user menu avatar */
	personId?: number;
	hideLogo?: boolean;
	smallLogo?: boolean;
	showTitle?: boolean;
	hideIcons?: boolean;
	hideUsername?: boolean;
	/** bg-{background} class on the header (ignored when transparent) */
	background?: string;
	/** inline `background:` style on the header */
	backgroundColor?: string;
	/** no-op — see the fluid-search note above */
	fluidSearch?: boolean;
	/** layout-navbar-class */
	class?: string;
}

// pageMenu is the front matter `page-menu` value; when a page has none, nothing
// in the menu is active (pages must pass their own value — see index.astro).
const {
	hideSearch = false,
	pageMenu,
	breakpoint = 'md',
	condensed = false,
	dark = false,
	transparent = false,
	overlap = false,
	sticky = false,
	hideBrand = false,
	sample = false,
	personId,
	hideLogo = false,
	smallLogo = false,
	showTitle = false,
	hideIcons = false,
	hideUsername = false,
	background,
	backgroundColor,
	class: className,
} = Astro.props;

const headerClass = [
	`navbar navbar-expand-${breakpoint}`,
	transparent ? 'navbar-transparent' : background && `bg-${background}`,
	sticky && 'sticky-top',
	overlap && 'navbar-overlap',
	className,
	'd-print-none',
]
---

{sticky && <Fragment set:html="<div class='sticky-top'>" />}

<!-- BEGIN NAVBAR -->
<header
	class:list={headerClass}
	style={backgroundColor ? `background: ${backgroundColor}` : undefined}
	data-bs-theme={dark ? 'dark' : undefined}
>
	<div class="container-xl">
		<NavbarToggler target="navbar-menu" />

		{
			!hideBrand && (
				<Logo
					header
					class="d-none-navbar-horizontal pe-0 pe-md-3"
					smallLogo={smallLogo}
					hideLogo={hideLogo}
					showTitle={showTitle}
				/>
			)
		}

		<NavbarSide
			class="order-md-last"
			breakpoint={breakpoint}
			condensed={condensed}
			dark={dark}
			personId={personId}
			hideUsername={hideUsername}
			showThemeToggle
			showNotifications
			showApps
			showLanguageSelector
			showUser
		/>

		{
			condensed && (
				<div class="collapse navbar-collapse" id="navbar-menu">
					{hideSearch ? (
						<Fragment>
							<Fragment set:html={'<!-- BEGIN NAVBAR MENU -->'} />
							<nav aria-label="Primary">
								<NavbarMenu sample={sample} hideIcons={hideIcons} pageMenu={pageMenu} />
							</nav>
							<Fragment set:html={'<!-- END NAVBAR MENU -->'} />
						</Fragment>
					) : (
						<div class="d-flex flex-column flex-md-row flex-fill align-items-stretch align-items-md-center">
							<!-- BEGIN NAVBAR MENU -->
							<nav aria-label="Primary">
								<NavbarMenu sample={sample} hideIcons={hideIcons} pageMenu={pageMenu} />
							</nav>
							<!-- END NAVBAR MENU -->
							{/* Search block omitted when condensed — nothing to render */}
						</div>
					)}
				</div>
			)
		}
	</div>
</header>

{
	!condensed && (
		<div class={`navbar-expand-${breakpoint}`}>
			<div class="collapse navbar-collapse" id="navbar-menu">
				<div class="navbar">
					<div class="container-xl">
						<div class="row flex-column flex-md-row flex-fill align-items-center">
							<div class="col">
								<!-- BEGIN NAVBAR MENU -->
								<nav aria-label="Primary">
									<NavbarMenu longTitles sample={sample} hideIcons={hideIcons} pageMenu={pageMenu} />
								</nav>
								<!-- END NAVBAR MENU -->
							</div>

							{!hideSearch && (
								<div class="col-2 d-none d-xxl-block">
									<NavbarSearch class="my-2 my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-last" />
								</div>
							)}

							<div class="col col-md-auto">
								<!-- BEGIN NAVBAR NAV -->
								<ul class="navbar-nav">
									<li class="nav-item">
										<a
											class="nav-link"
											href="#"
											data-bs-toggle="offcanvas"
											data-bs-target="#offcanvas-settings"
										>
											<span class="badge badge-sm bg-red text-red-fg">
												New
											</span>
											<span class="nav-link-icon d-md-none d-lg-inline-block">
												<Icon name="settings" />
											</span>
											<span class="nav-link-title"> Theme Settings </span>
										</a>
									</li>
								</ul>
								<!-- END NAVBAR NAV -->
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	)
}
<!-- END NAVBAR -->

{sticky && <Fragment set:html="</div>" />}
