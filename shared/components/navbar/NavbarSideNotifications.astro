---
import Icon from '@ui/Icon.astro'
import NotificationsCard from '../cards/NotificationsCard.astro'
import feed from '@data/notifications-feed.json'

const hasUnread = feed.some((group) => group.items.some((item) => 'unread' in item && item.unread))
---

<!-- BEGIN NOTIFICATIONS -->
<div class="nav-item dropdown d-none d-md-flex">
  <a href="#" class="nav-link px-0" data-bs-toggle="dropdown" aria-label="Show notifications" data-bs-auto-close="outside" aria-expanded="false">
    <Icon name="bell" />
    {hasUnread && <span class="badge bg-red" />}
  </a>
  <!-- BEGIN NAVBAR NOTIFICATIONS -->
  <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-end dropdown-menu-card" style="width: 24rem">
    <NotificationsCard />
  </div>
  <!-- END NAVBAR NOTIFICATIONS -->
</div>
<!-- END NOTIFICATIONS -->
