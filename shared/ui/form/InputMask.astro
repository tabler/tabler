---
interface Props {
  mask?: string
  visible?: boolean
  placeholder?: string
}

const { mask = '00/00/0000', visible, placeholder } = Astro.props
const name = 'mask'
---

<input type="text" name={`input-${name}`} class="form-control" data-mask={mask} data-mask-visible={visible ? 'true' : undefined} placeholder={placeholder ?? mask} autocomplete="off" />
