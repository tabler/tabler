---
// Forward `size` only when explicitly provided.
import Progress from './Progress.astro'
import type { ProgressSize } from './Progress.astro'

interface Props {
  label: string
  description?: string
  value?: number
  color?: string
  size?: ProgressSize | undefined
  class?: string
}

const { label, description, value, color, size, class: className } = Astro.props
---

<div class:list={[className]}>
  <div class="d-flex mb-1 align-items-center lh-1">
    <div class="fw-medium m-0">{label}</div>
    {description && <div class="text-secondary ms-2">{description}</div>}
    <span class="ms-auto text-secondary">{value}%</span>
  </div>
  <Progress size={size} value={value} color={color} />
</div>
