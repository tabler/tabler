---
// Data grid container (.datagrid); holds DatagridItem children.

type PolymorphicProps = { as?: 'div' | 'dl' }

interface Props extends PolymorphicProps {
  /** core/scss/ui/_datagrid.scss `.datagrid-horizontal`: label beside the value, one pair per row */
  variant?: 'horizontal' | undefined
  /** sets --tblr-datagrid-item-width, the minimum width of a column (e.g. `10rem`) */
  itemWidth?: string | undefined
  /** sets --tblr-datagrid-padding, the gap between items (e.g. `1rem`) */
  gap?: string | undefined
  /** sets --tblr-datagrid-title-width, the label column of the horizontal variant (e.g. `8rem`) */
  titleWidth?: string | undefined
  class?: string
  /** remaining attributes (id, data-*, aria-*, …) are forwarded to the root element */
  [key: string]: unknown
}

const { as: Tag = 'div', variant, itemWidth, gap, titleWidth, class: className, ...rest }: Props = Astro.props

const style = [itemWidth && `--tblr-datagrid-item-width: ${itemWidth}`, gap && `--tblr-datagrid-padding: ${gap}`, titleWidth && `--tblr-datagrid-title-width: ${titleWidth}`].filter(Boolean).join('; ')
---

<Tag class:list={['datagrid', variant && `datagrid-${variant}`, className]} style={style || undefined} {...rest}>
  <slot />
</Tag>
