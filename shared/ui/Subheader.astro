---
// Section subheader label (.subheader).

interface Props {
  /** element to render — default div */
  as?: string
  class?: string
  /** remaining attributes (colspan, …) are forwarded */
  [key: string]: unknown
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props
---

<Tag class:list={['subheader', className]} {...rest}>
  <slot />
</Tag>
