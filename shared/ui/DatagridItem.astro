---
// A single label/value pair (.datagrid-item); slot renders the value.

interface Props {
  title: string
  /** renders dt/dd instead of divs, for an item inside `<Datagrid as="dl">` */
  list?: boolean
  class?: string
}

const { title, list = false, class: className } = Astro.props

const TitleTag = list ? 'dt' : 'div'
const ContentTag = list ? 'dd' : 'div'
---

<div class:list={['datagrid-item', className]}>
  <TitleTag class="datagrid-title">{title}</TitleTag>
  <ContentTag class="datagrid-content">
    <slot />
  </ContentTag>
</div>
