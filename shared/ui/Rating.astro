---
// Rating initializes from `data-bs-toggle="rating"` and its `data-bs-*` options (tabler.js, core/js/src/rating.ts).
import { iconSvg } from '@shared/lib/svg'

type RatingSize = 'sm' | 'lg'

interface Props {
  /** data-bs-max: number of stars. */
  max?: number
  /** Initial value, written to the real input. */
  value?: number
  /** data-bs-half: allows half-star steps. */
  half?: boolean
  /** data-bs-clearable: clicking the selected star clears the value. */
  clearable?: boolean
  /** data-bs-readonly: display only, fractional fill, no radios rendered. */
  readonly?: boolean
  /** Icon name (from the icon set) used for each star. Defaults to a filled star. */
  icon?: string
  size?: RatingSize
  /** Any theme or extended color, applied as a `text-*` class. */
  color?: string
  ariaLabel?: string
  id?: string
  name?: string
  disabled?: boolean
  class?: string
  /** remaining attributes (data-*, …) are forwarded to the `.rating` wrapper */
  [key: string]: unknown
}

const { max, value, half, clearable, readonly, icon = 'star', size, color, ariaLabel, id, name, disabled, class: className, ...rest } = Astro.props

const iconMarkup = iconSvg(icon, { filled: true })

const wrapperClass = ['rating', size && `rating-${size}`, color && `text-${color}`, className]
---

<div class:list={wrapperClass} id={id} data-bs-toggle="rating" data-bs-max={max} data-bs-half={half ? 'true' : undefined} data-bs-clearable={clearable ? 'true' : undefined} data-bs-readonly={readonly ? 'true' : undefined} data-bs-icon={iconMarkup} aria-label={ariaLabel} {...rest}>
  <input type="hidden" name={name} value={value} disabled={disabled} />
</div>
