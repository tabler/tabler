---
// Color picker field: a text input the Colorpicker plugin in `tabler.js` picks
// up through `data-bs-toggle="colorpicker"`. The `.colorpicker` wrapper draws
// the swatch from the custom property the plugin sets on it.
interface Props {
  id: string
  value?: string
  name?: string
  placeholder?: string
  /** notation written to the field; `auto` keeps the one the value came in */
  format?: 'hex' | 'rgb' | 'hsl' | 'oklch' | 'auto'
  /** opacity slider and alpha channel */
  alpha?: boolean
  /** preset colours; the Tabler palette when omitted */
  swatches?: string[]
  /** hide the gradient and sliders, leaving the swatches */
  swatchesOnly?: boolean
  /** selector in the panel to switch the notation */
  formatToggle?: boolean
  clearButton?: boolean
  closeButton?: boolean
  /** render the panel in place instead of a popup */
  inline?: boolean
  disabled?: boolean
  /** field size: .form-control-sm / .form-control-lg */
  size?: 'sm' | 'lg'
  /** marks the field invalid (.is-invalid + aria-invalid) */
  invalid?: boolean
  class?: string
  /** accessible name for the input; falls back to a generic label when the caller doesn't wrap this in a labelled FormGroup */
  ariaLabel?: string
}

const { id, value, name, placeholder, format, alpha, swatches, swatchesOnly, formatToggle, clearButton, closeButton, inline, disabled, size, invalid, class: className, ariaLabel } = Astro.props

const flag = (enabled: boolean | undefined): 'true' | undefined => (enabled ? 'true' : undefined)
---

<div class:list={['colorpicker', className]}>
  <input
    type="text"
    class:list={['form-control', size && `form-control-${size}`, invalid && 'is-invalid']}
    id={id}
    name={name}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    aria-invalid={invalid ? 'true' : undefined}
    aria-label={ariaLabel ?? 'Color value'}
    data-bs-toggle="colorpicker"
    data-bs-format={format}
    data-bs-alpha={flag(alpha)}
    data-bs-swatches={swatches ? JSON.stringify(swatches) : undefined}
    data-bs-swatches-only={flag(swatchesOnly)}
    data-bs-format-toggle={flag(formatToggle)}
    data-bs-clear-button={flag(clearButton)}
    data-bs-close-button={flag(closeButton)}
    data-bs-inline={flag(inline)}
  />
</div>
