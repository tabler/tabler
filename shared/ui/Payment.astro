---
interface Props {
	payment?: string;
	dark?: boolean;
	size?: string;
	class?: string;
}

const { payment = 'visa', dark, size, class: className } = Astro.props;

// Only an explicit `size` becomes `payment-{size}`.
const classes = [
	'payment',
	size && `payment-${size}`,
	`payment-provider-${payment}${dark ? '-dark' : ''}`,
	className,
]
---

<span class:list={classes}></span>
