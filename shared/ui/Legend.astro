---
// Legend (.legend): marker + label, with an optional value.
// Renders a link when `href` is given, a button when `button` is set, a span otherwise.

interface Props {
  /** label text; the default slot is used instead when empty */
  text?: string
  /** legend-value next to the label */
  value?: string | number
  /** legend-{color} on the item, shared by the marker and the hover background */
  color?: string
  /** render a <button type="button"> (toggle control) */
  button?: boolean
  /** render an <a> with this target */
  href?: string
  /** active: keeps the hover background */
  active?: boolean
  /** legend-off: dims the item, for a hidden series */
  off?: boolean
  class?: string
  /** remaining attributes (id, data-*, aria-*, …) are forwarded to the root element */
  [key: string]: unknown
}

const { text, value, color, button, href, active, off, class: className, ...rest } = Astro.props

const Element = href ? 'a' : button ? 'button' : 'span'
const typeAttr = !href && button ? 'button' : undefined
const classes = ['legend', color && `legend-${color}`, active && 'active', off && 'legend-off', className]
---

<Element class:list={classes} href={href} type={typeAttr} {...rest}>
  <span class="legend-dot"></span>
  {text ?? <slot />}
  {value !== undefined && <span class="legend-value">{value}</span>}
</Element>
