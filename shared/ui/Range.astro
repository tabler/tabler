---
// A native <input type="range">. A plain `value` renders unenhanced; passing
// `connect` or a `[min, max]` value opts into the `Range` component for a
// filled track, a value tooltip and (for a `[min, max]` value) dual handles.
interface Props {
	min?: number;
	max?: number;
	/** single handle, or a [min, max] pair for a dual-handle range */
	value?: number | number[];
	id?: string;
	connect?: boolean;
	class?: string;
	/** remaining attributes (disabled, name, aria-*, data-*, …) are forwarded to the input(s) */
	[key: string]: unknown;
}

const { min = 0, max = 100, value = 50, id, connect = false, class: className, ...rest } = Astro.props;
const step = 10;

const values = Array.isArray(value) ? value : [value];
const isDual = values.length > 1;
// `id` used to select the noUiSlider target, which only ever rendered the
// enhanced (filled/tooltip) look — keep that the same for existing callers.
const enhanced = isDual || connect || Boolean(id);
---

{
	isDual ? (
		<div class:list={['form-range mb-2', className]} id={id} data-bs-toggle="range">
			{values.map((v) => (
				<input type="range" class="form-range-input" value={v} min={min} max={max} step={step} {...rest} />
			))}
		</div>
	) : (
		<input type="range" class:list={['form-range mb-2', className]} id={id} value={values[0]} min={min} max={max} step={step} data-bs-toggle={enhanced ? 'range' : undefined} {...rest} />
	)
}
