{
	"extends": "astro/tsconfigs/strict",
	"include": [
		"**/*"
	],
	"exclude": [
		"dist",
		"node_modules"
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@data/*": [
				"./data/*"
			],
			"@shared/*": [
				"./*"
			],
			"@ui/*": [
				"./ui/*"
			],
			"@components/*": [
				"./components/*"
			]
		}
	}
}
