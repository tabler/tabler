---
import BaseLayout from './BaseLayout.astro'
import Navbar from '@shared/components/navbar/Navbar.astro'
import Sidebar from '@shared/components/navbar/Sidebar.astro'
import PageHeader from '@shared/components/layout/PageHeader.astro'
import Footer from '@shared/components/layout/Footer.astro'

interface Props {
  title?: string | undefined
  /** Script/CSS library keys passed to BaseLayout */
  pageLibs?: string[]
  /** title shown in the page header; defaults to `title`, pass false for no page header */
  pageHeader?: string | false | undefined
  /** renders a layout/headers/{file} component instead of the title block */
  pageHeaderFile?: string | undefined
  /** small text above the page title */
  pretitle?: string | undefined
  /** text below the page title */
  description?: string | undefined
  /** active menu entry, e.g. "layout.vertical" */
  pageMenu?: string | undefined
  /** renders the vertical sidebar */
  sidebar?: boolean
  /** dark sidebar */
  sidebarDark?: boolean
  /** hides the top navbar */
  hideTopbar?: boolean
  /** adds my-auto to the .container-xl */
  containerCentered?: boolean
  /** page-wrapper-full and no .container-xl around the body */
  wrapperFull?: boolean
  /** extra classes on the .container-xl */
  containerClass?: string
  /** extra body classes, e.g. "layout-boxed" or "layout-fluid" */
  bodyClass?: string
  /** dir="rtl" and the RTL stylesheets */
  rtl?: boolean
  /** sidebar on the end side */
  sidebarEnd?: boolean
  /** icon-only sidebar rail with flyout submenus */
  sidebarFolded?: boolean
  /** folded rail that unfolds on hover/focus */
  sidebarFoldedHover?: boolean
  /** renders the runtime fold toggle button in the sidebar */
  sidebarFoldToggle?: boolean
  /** user block in the sidebar footer */
  sidebarUser?: boolean
  /** transparent sidebar */
  navbarTransparent?: boolean
  /** condensed single-row navbar */
  navbarCondensed?: boolean
  /** dark navbar */
  navbarDark?: boolean
  /** navbar overlapping the page header */
  navbarOverlap?: boolean
  /** sticky navbar */
  navbarSticky?: boolean
  /** hides the brand in the navbar */
  navbarHideBrand?: boolean
  /** extra classes on the navbar */
  navbarClass?: string
}

const {
  title,
  pageLibs,
  pageHeader,
  pageHeaderFile,
  pretitle,
  description,
  pageMenu,
  sidebar,
  sidebarDark,
  hideTopbar,
  containerCentered,
  wrapperFull,
  containerClass,
  bodyClass,
  rtl,
  sidebarEnd,
  sidebarFolded,
  sidebarFoldedHover,
  sidebarFoldToggle,
  sidebarUser,
  navbarTransparent,
  navbarCondensed,
  navbarDark,
  navbarOverlap,
  navbarSticky,
  navbarHideBrand,
  navbarClass,
} = Astro.props

// Most pages repeat the page title verbatim, so `pageHeader` falls back to `title`.
// Pages that deliberately have no header (blank, playgrounds) pass pageHeader={false}.
const headerTitle = pageHeader === false ? undefined : (pageHeader ?? title)
---

<BaseLayout title={title} pageLibs={pageLibs} bodyClass={bodyClass} rtl={rtl} description={description}>
  <div class="page">
    {
      sidebar && (
        <Fragment>
          <Fragment set:html={'<!--  BEGIN SIDEBAR  -->'} />
          <Sidebar dark={sidebarDark} end={sidebarEnd} transparent={navbarTransparent} folded={sidebarFolded} foldedHover={sidebarFoldedHover} foldToggle={sidebarFoldToggle} user={sidebarUser} breakpoint="lg" pageMenu={pageMenu} />
          <Fragment set:html={'<!--  END SIDEBAR  -->'} />
        </Fragment>
      )
    }

    {
      !hideTopbar && (
        <Fragment>
          <Fragment set:html={'<!-- BEGIN NAVBAR  -->'} />
          <Navbar hideSearch pageMenu={pageMenu} condensed={navbarCondensed} dark={navbarDark} overlap={navbarOverlap} sticky={navbarSticky} hideBrand={navbarHideBrand} class={navbarClass} />
          <Fragment set:html={'<!-- END NAVBAR  -->'} />
        </Fragment>
      )
    }

    <div class:list={['page-wrapper', wrapperFull && 'page-wrapper-full']}>
      <!-- BEGIN PAGE HEADER -->
      <PageHeader title={headerTitle} pretitle={pretitle} description={description} file={pageHeaderFile} textWhite={navbarOverlap && navbarDark}>
        <slot name="page-header-actions" slot="actions" />
      </PageHeader>
      <!-- END PAGE HEADER -->

      <!-- BEGIN PAGE BODY -->
      <main id="content" class="page-body">
        {
          wrapperFull ? (
            <slot />
          ) : (
            <div class={`container-xl${containerCentered ? ' my-auto' : ''}${containerClass ? ` ${containerClass}` : ''}`}>
              <slot />
            </div>
          )
        }
      </main>
      <!-- END PAGE BODY -->

      <!-- BEGIN FOOTER -->
      <Footer />
      <!-- END FOOTER -->
    </div>
  </div>
</BaseLayout>
