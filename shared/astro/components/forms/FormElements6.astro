---
// Port of shared/includes/forms/form-elements-6.html: datalist, range sliders
// (noUiSlider), datepickers, progress bars, form buttons, and TomSelect variants.
import flags from '@data/flags.json';
import Range from '../ui/Range.astro';
import Datepicker from '../ui/Datepicker.astro';
import Progress from '../ui/Progress.astro';
import Button from '../Button.astro';
import Select from '../ui/Select.astro';

const datalistCountries = (flags as { name: string }[]).slice(0, 10);
---

<div class="mb-3">
	<label class="form-label">Datalist example</label>
	<input class="form-control" list="datalistOptions" placeholder="Type to search..." />
	<datalist id="datalistOptions">
		{datalistCountries.map((country) => <option value={country.name} />)}
	</datalist>
</div>

<div class="mb-3">
	<label class="form-label">Range input</label>
	<Range value={40} />
	<Range value="20" id="simple" connect />
	<Range value="60,90" id="connect" />
	<Range value="40" id="color" class="text-green" connect />
</div>

<div class="mb-3">
	<label class="form-label">Datepicker</label>
	<Datepicker id="default" class="mb-2" />
	<Datepicker id="icon" layout="icon" class="mb-2" />
	<Datepicker id="icon-prepend" layout="icon-prepend" />
</div>

<div class="mb-3">
	<label class="form-label">Inline datepicker</label>
	<Datepicker id="inline" inline />
</div>

<div class="mb-3">
	<label class="form-label">Progress</label>
	<Progress class="mb-2" />
	<Progress indeterminate color="green" />
</div>

<div class="mb-3">
	<label class="form-label">Form buttons</label>
	<div class="row">
		<div class="col">
			<Button block icon="brand-github" iconColor="github" text="Login with Github" />
		</div>
		<div class="col">
			<Button block icon="brand-x" iconColor="x" text="Login with X" />
		</div>
	</div>
</div>

<div class="mb-3">
	<label class="form-label">Tags input</label>
	<Select key="tags" placeholder="Select tags" />
</div>

<div class="mb-3">
	<label class="form-label">Advanced select</label>
	<Select key="users" />
</div>

<div class="mb-3">
	<label class="form-label">Advanced select with optgroup</label>
	<Select key="optgroups" />
</div>

<div class="mb-3">
	<label class="form-label">Select with avatars</label>
	<Select key="people" indicator="avatar" />
</div>

<div class="mb-3">
	<label class="form-label">Select with flags</label>
	<Select key="countries" indicator="flag" />
</div>

<div class="mb-3">
	<label class="form-label">Select with labels</label>
	<Select key="labels" indicator="label" />
</div>

<div class="mb-3">
	<label class="form-label">Advanced select with validation state</label>
	<Select id="countries-valid" key="countries" state="valid" class="mb-3" />
	<Select id="countries-invalid" key="countries" state="invalid" />
</div>
