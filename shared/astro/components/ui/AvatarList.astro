---
// Port of shared/includes/ui/avatar-list.html.
// Loops over the `people` global with limit/offset.
// NOTE: avatar-list.html computes `size = include['size'] | default: 'sm'`, but on
// every caller here no size is passed, so Liquid's `include['size']` resolves to
// the include argument-count meta-property (the known size bug) — a numeric junk
// value (avatar-3/avatar-4) that the parity diff strips. We therefore pass NO size
// to Avatar so the output matches the stripped reference.
import Avatar from './Avatar.astro';
import people from '@data/people.json';

interface Person {
	full_name?: string;
	photo?: string;
	[key: string]: unknown;
}

interface Props {
	limit?: number;
	offset?: number;
	stacked?: boolean;
	class?: string;
	/** forwarded to each Avatar (e.g. "sm") */
	size?: string;
	/** forwarded to each Avatar (e.g. "rounded-circle") */
	avatarClass?: string;
	/** placeholder avatar appended after the list (unused on the widgets page) */
	text?: string;
}

const { limit = 5, offset = 0, stacked, class: className, size, avatarClass, text } = Astro.props;

const list = (people as Person[]).slice(offset, offset + limit);
---

<div class:list={['avatar-list', stacked && 'avatar-list-stacked', className]}>
	{list.map((person) => <Avatar person={person} size={size} class={avatarClass} />)}
	{text && <Avatar placeholder={text} size={size} class={avatarClass} />}
</div>
