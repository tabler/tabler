---
// Equivalent of ui/progressbg.html
import Progress from './Progress.astro';
import Flag from './Flag.astro';

interface Props {
	value?: number | string;
	color?: string;
	class?: string;
	text?: string;
	flag?: string;
	showValue?: boolean;
}

const {
	value,
	color = 'primary-lt',
	class: className,
	text,
	flag,
	showValue,
} = Astro.props;

// Liquid: {% assign percentage = include.value | replace: '%', '' | default: 0 %}
const percentage = `${value ?? ''}`.split('%').join('') || '0';
---

<div class={`progressbg${className ? ` ${className}` : ''}`}>
	<Progress value={percentage} class="progressbg-progress" color={color} />
	{text && <div class="progressbg-text">{flag && <Flag flag={flag} class="me-2" size="xs" />}{text}</div>}
	{showValue && <div class="progressbg-value">{percentage}%</div>}
</div>
