---
import FormFooter from '../ui/FormFooter.astro';
import FormGroup from '../ui/FormGroup.astro';
import InputGroup from '../ui/InputGroup.astro';
---

<form action="./" method="get" autocomplete="off" novalidate>
	<FormGroup label="Email address">
		<input type="email" class="form-control" placeholder="your@email.com" autocomplete="off" />
	</FormGroup>
	<div class="mb-2">
		<label class="form-label">
			Password
			<span class="form-label-description">
				<a href="./forgot-password.html">I forgot password</a>
			</span>
		</label>
		<InputGroup type="password" placeholder="Your password" flat appendButton="eye:Show password" />
	</div>
	<div class="mb-2">
		<label class="form-check">
			<input type="checkbox" class="form-check-input" />
			<span class="form-check-label">Remember me on this device</span>
		</label>
	</div>

	<FormFooter>
		<button type="submit" class="btn btn-primary w-100">Sign in</button>
	</FormFooter>
</form>
