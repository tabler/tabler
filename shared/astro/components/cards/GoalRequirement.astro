---
import Icon from '../Icon.astro'
import Progress from '../ui/Progress.astro'

interface Props {
	done?: boolean
	title: string
	meta: string
	progress: number
}

const { done, title, meta, progress } = Astro.props
---

<div class="card-body d-flex justify-content-between flex-wrap">
	<div class="d-flex align-items-center gap-3">
		<Icon name={done ? 'circle-check' : 'circle'} color={done ? 'success' : 'secondary'} />
		<div>
			<h3 class="m-0">{title}</h3>
			<p class="text-secondary fs-5 m-0">{meta}</p>
		</div>
	</div>

	<div class="d-flex align-items-center gap-3">
		<Progress value={progress} width="12rem" />
		<span>{progress}%</span>
	</div>
</div>
