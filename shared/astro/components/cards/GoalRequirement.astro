---
import Icon from '../Icon.astro'
import Progress from '../ui/Progress.astro'

interface Props {
	done?: boolean
	title: string
	meta: string
	progress: number
}

const { done, title, meta, progress } = Astro.props
---

<div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
	<div class="d-flex align-items-center gap-3 overflow-hidden">
		<Icon name={done ? 'circle-check' : 'circle'} color={done ? 'success' : 'secondary'} class="flex-shrink-0" />
		<div class="overflow-hidden">
			<h3 class="m-0 text-truncate">{title}</h3>
			<p class="text-secondary fs-5 m-0 text-truncate">{meta}</p>
		</div>
	</div>

	<div class="d-flex align-items-center gap-3 flex-grow-1" style="max-width: 16rem; min-width: 10rem">
		<Progress value={progress} class="flex-fill" />
		<span class="flex-shrink-0">{progress}%</span>
	</div>
</div>
