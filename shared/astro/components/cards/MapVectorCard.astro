---
// Port cards/map-vector.html
import MapVector from '../ui/MapVector.astro';

interface Props {
	title?: string;
	map?: string;
}

const { title, map = 'world' } = Astro.props;
---

<div class="card">
	<div class="card-body">
		{title && <h3 class="card-title">{title}</h3>}
		<MapVector mapId={map} color="primary" ratio="21x9" />
	</div>
</div>
