---

import Subheader from '../../ui/Subheader.astro';
import Chart from '../../ui/Chart.astro';
---

<div class="card">
	<div class="card-body">
		<div class="d-flex align-items-start justify-content-between gap-3 mb-2">
			<div class="mb-3">
				<Subheader>Monthly recurring revenue</Subheader>
				<div class="d-flex align-items-baseline gap-2 mt-1">
					<div class="h1 mb-0">$92,400</div>
					<div class="text-green fw-medium">+9.5%</div>
				</div>
			</div>

			<div class="d-flex align-items-center gap-3">
				<div class="d-flex align-items-center gap-2">
					<span class="legend bg-primary"></span>
					<span class="text-secondary">This year</span>
				</div>
				<div class="d-flex align-items-center gap-2">
					<span class="legend bg-secondary"></span>
					<span class="text-secondary">Last year</span>
				</div>
			</div>
		</div>

		<Chart chartId="crm-mrr-overview" height={15} />
	</div>
</div>
