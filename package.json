    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.5.4",
    "bundlewatch": "^0.4.2",
    "clean-css-cli": "^5.6.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "js-beautify": "^2.0.3",
    "markdownlint-cli": "^0.49.1",
    "nodemon": "^3.1.14",
    "pnpm": "10.34.4",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "rtlcss": "^4.3.0",
    "sass": "1.102.0",
    "shelljs": "^0.10.0",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
