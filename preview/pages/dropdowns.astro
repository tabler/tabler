---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import DropdownMenu from '@components/demo/DropdownMenu.astro'
import DropdownMenuAll from '@components/demo/DropdownMenuAll.astro'
import DocsLink from '@ui/DocsLink.astro'
import countries from '@data/countries.json'

const countryNames = (countries as { name: string }[]).slice(0, 15).map((country) => country.name)
---

<DefaultLayout title="Dropdowns" pageMenu="base.dropdowns" cssPlugins={['flags']} description="Dropdown menus for actions, filters, and selections, always shown open here for reference.">
  <DocsLink slot="page-header-actions" path="/ui/components/dropdown" />

  <div class="row">
    <div class="col-sm-6 col-lg-3">
      <DropdownMenuAll show />
    </div>
    <div class="col-sm-6 col-lg-3">
      <DropdownMenu show />
      <DropdownMenu show separated />
      <DropdownMenu show active />
      <DropdownMenu show disabled />
      <DropdownMenu show header />
      <DropdownMenu show icons header />
      <DropdownMenu show arrow />
    </div>
    <div class="col-sm-6 col-lg-3">
      <DropdownMenu show />
      <DropdownMenu show separated />
      <DropdownMenu show active />
      <DropdownMenu show disabled />
      <DropdownMenu show header />
      <DropdownMenu show icons />
      <DropdownMenu show badge />
    </div>
    <div class="col-sm-6 col-lg-3">
      <DropdownMenu show dark />
      <DropdownMenu show dark separated />
      <DropdownMenu show arrow right dark />
      <DropdownMenu show arrow right dark icons />
      <DropdownMenu show check />
      <DropdownMenu show radio />
      <DropdownMenu show people />
      <DropdownMenu show flag />
      <div class="dropdown-menu dropdown-menu-demo dropdown-menu-scrollable scroll-shadow-y">
        {
          countryNames.map((name) => (
            <a class="dropdown-item" href="#">
              {name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</DefaultLayout>
