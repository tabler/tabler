---
import SingleLayout from '@shared/layouts/SingleLayout.astro'
import IconList from '@ui/IconList.astro'
import IconListItem from '@ui/IconListItem.astro'
---

<SingleLayout title="Trial ended">
  <div class="card card-md">
    <div class="card-body">
      <h1 class="mb-3 fs-2">Your free trial period has expired!</h1>

      <p class="text-secondary mb-4">If you want to continue to benefit from Tabler, it's time to upgrade your plan.</p>

      <IconList color="success" style="--tblr-list-icon-row-gap: 1rem">
        <IconListItem>
          <span>
            <strong class="d-block">Over 800+ productions</strong>
            <span class="d-block text-secondary">Unlimited movies, TV shows and more.</span>
          </span>
        </IconListItem>
        <IconListItem>
          <span>
            <strong class="d-block">Watch everywhere</strong>
            <span class="d-block text-secondary">Watch on smart TVs, PlayStation, Xbox, Apple TV, Blu-ray players and more.</span>
          </span>
        </IconListItem>
        <IconListItem>
          <span>
            <strong class="d-block">Personalize</strong>
            <span class="d-block text-secondary">Choose your own style, watch what you like.</span>
          </span>
        </IconListItem>
      </IconList>

      <div class="my-4">
        <a href="#" class="btn btn-primary w-100"> Upgrade to a paid plan </a>
      </div>

      <p class="text-secondary">
        If you need to get a trial extension please feel free to <a href="#">contact us</a>.
      </p>
    </div>
  </div>
</SingleLayout>
