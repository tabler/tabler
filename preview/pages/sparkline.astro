---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import CaptureScript from '@shared/components/CaptureScript.astro'
import Card from '@ui/Card.astro'
import CardBody from '@ui/CardBody.astro'
import CardTitle from '@ui/CardTitle.astro'
import CardSubtitle from '@ui/CardSubtitle.astro'
import Badge from '@ui/Badge.astro'
import site from '@data/site.json'
import { ucFirst } from '@shared/lib/string-format'

const colors = Object.keys(site.colors)

const metrics = [
  { name: 'Revenue', value: '$12.4k', color: 'success', type: 'line', fill: 'auto', values: '5,6,7,6,8,9,10' },
  { name: 'Orders', value: '1,352', color: 'primary', type: 'bar', values: '3,4,2,6,5,8,7' },
  { name: 'Errors', value: '31', color: 'danger', type: 'bar', values: '2,3,5,4,8,13,21' },
  { name: 'CPU usage', value: '72%', color: 'info', type: 'line', values: '40,55,50,70,65,80,72' },
]

const progress = [
  { label: 'Completion 10%', value: 10, color: 'danger' },
  { label: 'Completion 50%', value: 50, color: 'warning' },
  { label: 'Completion 72%', value: 72, color: 'primary' },
  { label: 'Completion 100%', value: 100, color: 'success' },
]
---

<DefaultLayout title="Sparkline" pageMenu="base.sparkline" description="Sparklines are tiny inline SVG charts rendered from data attributes, with no chart library needed.">
  <div class="row row-cards">
    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Line</CardTitle>
          <CardSubtitle>Add <code>data-bs-toggle="sparkline"</code> and a comma-separated <code>data-bs-values</code> list.</CardSubtitle>
          <span class="sparkline text-primary" data-bs-toggle="sparkline" data-bs-type="line" data-bs-values="3,4,2,6,5,8,7" aria-label="Weekly trend"></span>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Area with spot</CardTitle>
          <CardSubtitle>Use <code>data-bs-fill="auto"</code> for a tinted area and <code>data-bs-spot</code> to mark the <code>last</code>, <code>min</code> or <code>max</code> value.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            <span class="sparkline text-success" data-bs-toggle="sparkline" data-bs-type="line" data-bs-fill="auto" data-bs-spot="last" data-bs-values="12,14,9,18,16,22,20" aria-label="Last value"></span>
            <span class="sparkline text-danger" data-bs-toggle="sparkline" data-bs-type="line" data-bs-fill="auto" data-bs-spot="min" data-bs-values="12,14,9,18,16,22,20" aria-label="Lowest value"></span>
            <span class="sparkline text-azure" data-bs-toggle="sparkline" data-bs-type="line" data-bs-fill="auto" data-bs-spot="max" data-bs-values="12,14,9,18,16,22,20" aria-label="Highest value"></span>
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Bars</CardTitle>
          <CardSubtitle>Set <code>data-bs-type="bar"</code>. Tune the gap and rounding with <code>data-bs-bar-gap</code> and <code>data-bs-bar-radius</code>.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            <span class="sparkline text-warning" data-bs-toggle="sparkline" data-bs-type="bar" data-bs-values="1,2,3,2,4,3,5" aria-label="Daily activity"></span>
            <span class="sparkline text-purple" data-bs-toggle="sparkline" data-bs-type="bar" data-bs-bar-gap="4" data-bs-bar-radius="0" data-bs-values="1,2,3,2,4,3,5" aria-label="Daily activity, square bars"></span>
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Circle</CardTitle>
          <CardSubtitle>Use <code>data-bs-type="circle"</code> with a single value as a share of <code>data-bs-max</code>.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            {
              progress.map((item) => (
                <span
                  class:list={['sparkline', `text-${item.color}`]}
                  style="--tblr-sparkline-width: 2rem; --tblr-sparkline-height: 2rem; --tblr-sparkline-stroke-width: 3"
                  data-bs-toggle="sparkline"
                  data-bs-type="circle"
                  data-bs-values={item.value}
                  data-bs-max="100"
                  data-bs-width="32"
                  data-bs-height="32"
                  aria-label={item.label}
                />
              ))
            }
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Colors</CardTitle>
          <CardSubtitle>The chart uses <code>currentColor</code>, so any <code>text-{'{color}'}</code> utility themes it.</CardSubtitle>
          <div class="d-flex flex-wrap align-items-center gap-3">
            {colors.map((color) => <span class:list={['sparkline', `text-${color}`]} data-bs-toggle="sparkline" data-bs-type="line" data-bs-fill="auto" data-bs-values="2,3,2,4,3,5,4" aria-label={ucFirst(color)} />)}
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Fixed range</CardTitle>
          <CardSubtitle>Set <code>data-bs-min</code> and <code>data-bs-max</code> so several charts share the same scale.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            <span class="sparkline text-primary" data-bs-toggle="sparkline" data-bs-type="line" data-bs-min="0" data-bs-max="100" data-bs-values="10,20,35,30,45,60,55" aria-label="Series A, 0 to 100"></span>
            <span class="sparkline text-danger" data-bs-toggle="sparkline" data-bs-type="line" data-bs-min="0" data-bs-max="100" data-bs-values="5,15,25,40,70,65,80" aria-label="Series B, 0 to 100"></span>
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Sizes</CardTitle>
          <CardSubtitle>Override <code>--tblr-sparkline-width</code> and <code>--tblr-sparkline-height</code>; the SVG scales to fit.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            <span class="sparkline text-info" style="--tblr-sparkline-width: 3rem; --tblr-sparkline-height: 1rem" data-bs-toggle="sparkline" data-bs-type="line" data-bs-values="2,3,2,4,3,5,4" aria-label="Small"></span>
            <span class="sparkline text-info" data-bs-toggle="sparkline" data-bs-type="line" data-bs-values="2,3,2,4,3,5,4" aria-label="Default"></span>
            <span class="sparkline text-info" style="--tblr-sparkline-width: 9rem; --tblr-sparkline-height: 2rem" data-bs-toggle="sparkline" data-bs-type="line" data-bs-values="2,3,2,4,3,5,4" aria-label="Large"></span>
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Stroke width</CardTitle>
          <CardSubtitle>Change <code>--tblr-sparkline-stroke-width</code> and <code>--tblr-sparkline-spot-size</code> in SVG units.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            <span class="sparkline text-primary" style="--tblr-sparkline-stroke-width: 1; --tblr-sparkline-spot-size: 1.5" data-bs-toggle="sparkline" data-bs-type="line" data-bs-spot="last" data-bs-values="3,4,2,6,5,8,7" aria-label="Thin"></span>
            <span class="sparkline text-primary" data-bs-toggle="sparkline" data-bs-type="line" data-bs-spot="last" data-bs-values="3,4,2,6,5,8,7" aria-label="Default"></span>
            <span class="sparkline text-primary" style="--tblr-sparkline-stroke-width: 4; --tblr-sparkline-spot-size: 3" data-bs-toggle="sparkline" data-bs-type="line" data-bs-spot="last" data-bs-values="3,4,2,6,5,8,7" aria-label="Thick"></span>
          </div>
        </CardBody>
      </Card>
    </div>

    <div class="col-md-6 col-lg-4">
      <Card>
        <CardBody>
          <CardTitle>Update from JavaScript</CardTitle>
          <CardSubtitle>Call <code>update(values)</code> on the instance. It writes <code>data-bs-values</code> back and fires <code>updated.bs.sparkline</code>.</CardSubtitle>
          <div class="d-flex align-items-center gap-3">
            <span id="sparkline-orders" class="sparkline text-primary" data-bs-toggle="sparkline" data-bs-type="line" data-bs-fill="auto" data-bs-spot="last" data-bs-values="3,4,2,6,5,8,7" aria-label="Orders"></span>
            <button id="sparkline-update" type="button" class="btn btn-sm btn-outline-primary">Randomize</button>
            <Badge id="sparkline-updates" color="secondary" outline>0 updates</Badge>
          </div>
          <CaptureScript>
            <!-- BEGIN SCRIPT OF SPARKLINE -->
            <script is:inline>
              /*
              Pushes random data into a sparkline and counts the updated.bs.sparkline events.
              tabler.js is deferred, so the instance is looked up once the DOM is ready.
              */
              document.addEventListener('DOMContentLoaded', () => {
                const element = document.getElementById('sparkline-orders')
                const sparkline = tabler.Sparkline.getOrCreateInstance(element)
                let updates = 0

                document.getElementById('sparkline-update').addEventListener('click', () => {
                  sparkline.update(Array.from({ length: 10 }, () => Math.floor(Math.random() * 30)))
                })

                element.addEventListener('updated.bs.sparkline', () => {
                  updates += 1
                  document.getElementById('sparkline-updates').textContent = `${updates} update${updates === 1 ? '' : 's'}`
                })
              })
            </script>
            <!-- END SCRIPT OF SPARKLINE -->
          </CaptureScript>
        </CardBody>
      </Card>
    </div>

    <div class="col-lg-8">
      <Card>
        <CardBody>
          <CardTitle>In a table</CardTitle>
          <CardSubtitle>A sparkline sits inline with text, so it works in table cells and stat rows.</CardSubtitle>
          <div class="table-responsive">
            <table class="table table-vcenter card-table">
              <thead>
                <tr>
                  <th>Metric</th>
                  <th class="text-end">Value</th>
                  <th class="text-end">Trend</th>
                </tr>
              </thead>
              <tbody>
                {
                  metrics.map((metric) => (
                    <tr>
                      <td>{metric.name}</td>
                      <td class="text-end">{metric.value}</td>
                      <td class="text-end">
                        <span class:list={['sparkline', `text-${metric.color}`]} data-bs-toggle="sparkline" data-bs-type={metric.type} data-bs-fill={metric.fill} data-bs-values={metric.values} aria-label={`${metric.name} trend`} />
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </CardBody>
      </Card>
    </div>
  </div>
</DefaultLayout>
