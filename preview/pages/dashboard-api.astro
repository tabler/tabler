---

<DefaultLayout title="API Usage" description="Calls, errors, latency and rate limits of your public API over the last 24 hours." pageMenu="dashboards.api" pageLibs={['apexcharts']}>
  <div class="row row-cards">
    {
      stats.map((stat) => (
        <div class="col-sm-6 col-lg-4 col-xl-2">
          <Card>
            <CardBody>
              <Subheader as="h2">{stat.title}</Subheader>
              <div class="d-flex align-items-baseline">
                <div class="h2 mb-0 me-2">{stat.value}</div>
                <Trending value={stat.change} />
              </div>
            </CardBody>
            <Chart chartId={stat.chart} size="sm" class="rounded-bottom-3" label={`${stat.title} over the last 24 hours`} />
          </Card>
        </div>
      ))
    }

    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="API calls over time">
          <div class="card-actions d-flex align-items-center gap-2">
            <label for="calls-group-by" class="form-label mb-0 text-secondary">Group by</label>
            <select id="calls-group-by" class="form-select form-select-sm w-auto">
              {groupBy.map((option) => <option>{option}</option>)}
            </select>
          </div>
        </CardHeader>
        <CardBody>
          <LegendList class="mb-3">
            <Legend color="primary" text="API calls" value="4.21M" />
          </LegendList>
          <Chart chartId="api-calls" height={15} label="API calls over time" />
        </CardBody>
      </Card>
    </div>
    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Latency percentiles" />
        <CardBody>
          <LegendList class="mb-3">
            {latency.map((item) => <Legend color={item.color} text={item.name} value={item.value} unit="ms" />)}
          </LegendList>
          <Chart chartId="api-latency" height={15} label="Latency percentiles" />
        </CardBody>
      </Card>
    </div>

    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Responses by status code" />
        <CardBody>
          <LegendList class="mb-3">
            {statusCodes.map((item) => <Legend color={item.color} text={item.name} value={item.value} />)}
          </LegendList>
          <Chart chartId="api-status" height={15} label="Responses by status code" />
        </CardBody>
      </Card>
    </div>
    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Calls by API version" />
        <CardBody>
          <LegendList class="mb-3">
            {versions.map((item) => <Legend color={item.color} text={item.name} value={item.value} />)}
          </LegendList>
          <Chart chartId="api-versions" height={15} label="Calls by API version" />
        </CardBody>
      </Card>
    </div>

    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Rate limit events" />
        <CardBody>
          <LegendList class="mb-3">
            <Legend color="orange" text="Rate limited" value="12.4k" />
          </LegendList>
          <Chart chartId="api-rate-limited" height={15} label="Rate limit events over time" />
        </CardBody>
      </Card>
    </div>
    <div class="col-lg-6">
      <TopList title="Top endpoints" items={lists['Top endpoints'] ?? []} class="h-100" />
    </div>

    {
      Object.entries(lists)
        .filter(([title]) => title !== 'Top endpoints')
        .map(([title, items]) => (
          <div class="col-lg-6">
            <TopList title={title} items={items} unit={title === 'Top consumers by data out' ? 'GB' : undefined} class="h-100" />
          </div>
        ))
    }
  </div>
</DefaultLayout>
