---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
---

<DefaultLayout title="Full Size Map" pageHeader={false} pageMenu="plugins.map-fullsize" pageLibs={['maplibre-gl']} navbarPosition="vertical" wrapperFull>
  <h1 class="visually-hidden">Full Size Map</h1>
  <div class="map flex-fill" id="map-fullsize" role="region" aria-label="Map of Berlin" data-bs-toggle="map" data-bs-center="13.4049,52.518827" data-bs-zoom="12" data-bs-controls="zoom,north,locate,fullscreen"></div>
</DefaultLayout>
