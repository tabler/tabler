---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import IconsBanner from '@shared/components/cards/IconsBanner.astro'
import Icons from '@shared/components/cards/Icons.astro'
import DocsLink from '@ui/DocsLink.astro'
---

<DefaultLayout title="Icons" pageMenu="addons.icons">
  <DocsLink slot="page-header-actions" path="/ui/components/icon" />
  <div class="row row-cards">
    <div class="col-lg-4">
      <IconsBanner />
    </div>
    <div class="col">
      <div class="row row-cards">
        <div class="col-12">
          <Icons title="Interface icons" type="outline" />
        </div>
        <div class="col-12">
          <Icons title="Filled icons" type="filled" />
        </div>
      </div>
    </div>
  </div>
</DefaultLayout>
