---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import Card from '@ui/Card.astro'
import CardBody from '@ui/CardBody.astro'
import CardTitle from '@ui/CardTitle.astro'
import CardSubtitle from '@ui/CardSubtitle.astro'
import site from '@data/site.json'
import DocsLink from '@ui/DocsLink.astro'

type ColorEntry = [string, { title: string; hex?: string; prop?: string; abbr?: string; icon?: string }]
type Tile = { title: string; code: string; class: string }
type Section = { title: string; subtitle: string; tiles: Tile[] }

const themeColorNames = ['primary', 'secondary', 'success', 'info', 'warning', 'danger']
const themeColors = (Object.entries(site.themeColors) as ColorEntry[]).filter(([name]) => themeColorNames.includes(name))
const colors = Object.entries(site.colors) as ColorEntry[]
const grayColors = Object.entries(site.grayColors) as ColorEntry[]
const socialColors = Object.entries(site.socialColors) as ColorEntry[]

const fillLevels = ['primary', 'secondary', 'tertiary', 'quaternary']

const colorTitle = (name: string) => (site.colors as Record<string, { title: string }>)[name]?.title ?? name

const gradientPairs: [string, string][] = [
  ['blue', 'purple'],
  ['pink', 'orange'],
  ['green', 'cyan'],
  ['indigo', 'pink'],
  ['yellow', 'red'],
  ['teal', 'lime'],
]
const gradientTrios: [string, string, string][] = [
  ['purple', 'pink', 'orange'],
  ['blue', 'cyan', 'green'],
  ['red', 'orange', 'yellow'],
  ['indigo', 'purple', 'pink'],
]
const gradientDirections: [string, string][] = [
  ['to-t', 'Top'],
  ['to-te', 'Top end'],
  ['to-e', 'End'],
  ['to-be', 'Bottom end'],
  ['to-b', 'Bottom'],
  ['to-bs', 'Bottom start'],
  ['to-s', 'Start'],
  ['to-ts', 'Top start'],
]

const sections: Section[] = [
  {
    title: 'Theme colors',
    subtitle: 'Colors with a meaning: the brand color and the status colors. Each swatch shows the light mode value on the left and the dark mode value on the right.',
    tiles: themeColors.map(([name, color]) => ({ title: color.title, code: `var(--tblr-${name})`, class: `bg-${name}` })),
  },
  {
    title: 'Colors',
    subtitle: 'The extended palette.',
    tiles: colors.map(([name, color]) => ({ title: color.title, code: `var(${color.prop})`, class: `bg-${name}` })),
  },
  {
    title: 'Light colors',
    subtitle: 'A tinted, low-contrast version of each color.',
    tiles: colors.map(([name, color]) => ({ title: `${color.title} light`, code: `var(${color.prop}-lt)`, class: `bg-${name}-lt` })),
  },
  {
    title: 'Gray colors',
    subtitle: 'The neutral gray scale used for text, borders, and backgrounds.',
    tiles: grayColors.map(([name, color]) => ({ title: color.title, code: `var(${color.prop})`, class: `bg-${name}` })),
  },
  {
    title: 'Fill colors',
    subtitle: 'Translucent fills made from the text color, for hover states, tracks, and subtle backgrounds. Use them with <code>.bg-fill-*</code>.',
    tiles: fillLevels.map((level) => ({ title: `Fill ${level}`, code: `var(--tblr-fill-${level})`, class: `bg-fill-${level}` })),
  },
  {
    title: 'Social colors',
    subtitle: 'Brand colors for social networks. They are the same in light and dark mode.',
    tiles: socialColors.map(([name, color]) => ({ title: color.title, code: `var(${color.prop})`, class: `bg-${name}` })),
  },
  {
    title: 'Gradient fade',
    subtitle: 'Fade any color to transparent with <code>.bg-gradient-from-*</code> and <code>.bg-gradient-to-transparent</code>.',
    tiles: colors.map(([name, color]) => ({ title: color.title, code: `.bg-gradient-from-${name}`, class: `bg-gradient bg-gradient-from-${name} bg-gradient-to-transparent bg-gradient-to-b` })),
  },
  {
    title: 'Two colors',
    subtitle: 'Pair <code>.bg-gradient-from-*</code> with <code>.bg-gradient-to-*</code>.',
    tiles: gradientPairs.map(([from, to]) => ({ title: `${colorTitle(from)} → ${colorTitle(to)}`, code: `from-${from} to-${to}`, class: `bg-gradient bg-gradient-from-${from} bg-gradient-to-${to}` })),
  },
  {
    title: 'Three colors',
    subtitle: 'Add a middle stop with <code>.bg-gradient-via-*</code>.',
    tiles: gradientTrios.map(([from, via, to]) => ({
      title: `${colorTitle(from)} → ${colorTitle(via)} → ${colorTitle(to)}`,
      code: `from-${from} via-${via} to-${to}`,
      class: `bg-gradient bg-gradient-from-${from} bg-gradient-via-${via} bg-gradient-to-${to}`,
    })),
  },
  {
    title: 'Gradient directions',
    subtitle: 'Set the direction with <code>.bg-gradient-to-t</code>, <code>.bg-gradient-to-e</code> and the other side classes.',
    tiles: gradientDirections.map(([direction, title]) => ({ title, code: `.bg-gradient-${direction}`, class: `bg-gradient bg-gradient-from-primary bg-gradient-to-transparent bg-gradient-${direction}` })),
  },
]
const modes = ['light', 'dark']
---

<DefaultLayout title="Colors" pageMenu="base.colors" description="The full color palette and gradients, in light and dark mode, with CSS variables.">
  <DocsLink slot="page-header-actions" path="/ui/base/colors" />

  <div class="row row-cards">
    {
      sections.map((section) => (
        <div class="col-12">
          <Card>
            <CardBody>
              <CardTitle>{section.title}</CardTitle>
              <CardSubtitle>
                <Fragment set:html={section.subtitle} />
              </CardSubtitle>
              <div class="row g-3">
                {section.tiles.map((tile) => (
                  <div class="col-6 col-sm-4 col-md-3 col-xl-2">
                    <div class="border rounded overflow-hidden">
                      <div class="d-flex">
                        {modes.map((mode) => (
                          <div class="flex-fill bg-surface" data-bs-theme={mode}>
                            <div class={`py-6 ${tile.class}`} />
                          </div>
                        ))}
                      </div>
                      <div class="px-3 py-2 border-top">
                        <div>{tile.title}</div>
                        <div class="small text-truncate" title={tile.code}>
                          <code>{tile.code}</code>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </CardBody>
          </Card>
        </div>
      ))
    }
  </div>
</DefaultLayout>
