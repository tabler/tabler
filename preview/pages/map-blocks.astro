---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import MapStoreLocator from '@components/cards/MapStoreLocator.astro'
import MapDeliveryTracker from '@components/cards/MapDeliveryTracker.astro'
import MapLiveUsers from '@components/cards/MapLiveUsers.astro'
import MapUsersByCountry from '@components/cards/MapUsersByCountry.astro'
import DocsLink from '@ui/DocsLink.astro'
---

<DefaultLayout title="Map blocks" pageMenu="plugins.map-blocks" pageLibs={['maplibre-gl', 'jsvectormap']} description="Ready-made blocks that pair a map with a list, a card or a table.">
  <DocsLink slot="page-header-actions" path="/ui/components/map" />

  <div class="row row-cards">
    <div class="col-12">
      <MapStoreLocator />
    </div>
    <div class="col-lg-6">
      <MapDeliveryTracker />
    </div>
    <div class="col-lg-6">
      <MapLiveUsers />
    </div>
    <div class="col-12">
      <MapUsersByCountry />
    </div>
  </div>
</DefaultLayout>
