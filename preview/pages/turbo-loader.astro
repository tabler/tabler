---
// Port of preview/pages/turbo-loader.html (layout: default, page-libs: [turbo]).
import DefaultLayout from '@shared/layouts/DefaultLayout.astro';
import ButtonList from '@shared/components/ui/ButtonList.astro';
import Card from '@shared/components/ui/Card.astro';
import CardBody from '@shared/components/ui/CardBody.astro';
---

<DefaultLayout pageMenu="plugins.turbo" pageLibs={['turbo']}>
	<Card>
		<CardBody>
			<ButtonList>
				<button class="btn" id="show-loader">Show loader</button>
				<button class="btn" id="hide-loader">Hide loader</button>
				<button class="btn" id="set-10">Set 10%</button>
				<button class="btn" id="set-50">Set 50%</button>
				<button class="btn" id="set-100">Set 100%</button>
			</ButtonList>
		</CardBody>
	</Card>
	<!--
		is:inline: turbo loads via a deferred page-lib <script>; see FormElements1.astro
		for why a processed (module) script here would run too early and find
		window.Turbo undefined.
	-->
	<script is:inline>
		function initTurboLoader() {
			Turbo.session.drive = false;

			if (window.Turbo) {
				const loader = Turbo.navigator.delegate.adapter.progressBar;

				console.log(loader);

				document.getElementById('show-loader').addEventListener('click', (e) => {
					loader.show();
					e.preventDefault();
				});

				document.getElementById('hide-loader').addEventListener('click', (e) => {
					loader.hide();
					e.preventDefault();
				});

				document.getElementById('set-10').addEventListener('click', (e) => {
					loader.show();
					loader.setValue(0.1);
					e.preventDefault();
				});

				document.getElementById('set-50').addEventListener('click', (e) => {
					loader.show();
					loader.setValue(0.5);
					e.preventDefault();
				});

				document.getElementById('set-100').addEventListener('click', (e) => {
					loader.show();
					loader.setValue(1);
					setTimeout(() => {
						loader.hide();
					}, 1000);
					e.preventDefault();
				});
			}
		}

		document.readyState !== 'loading' ? initTurboLoader() : document.addEventListener('DOMContentLoaded', initTurboLoader, { once: true });
	</script>
</DefaultLayout>
