---
// Port of preview/pages/card-actions.html.
import DefaultLayout from '@shared/layouts/DefaultLayout.astro';
import BodyPlaceholder from '@shared/components/cards/BodyPlaceholder.astro';
import Card from '@shared/components/ui/Card.astro';
import CardHeader from '@shared/components/ui/CardHeader.astro';
import CardTitle from '@shared/components/ui/CardTitle.astro';
import Button from '@shared/components/ui/Button.astro';
import Avatar from '@shared/components/ui/Avatar.astro';
import Icon from '@shared/components/ui/Icon.astro';
import people from '@data/people.json';

const person0 = people[0];
const person3 = people[3];
---

<DefaultLayout title="Card actions" pageHeader="Card actions" pageMenu="base.cards.actions">
	<div class="row row-cards">
		<div class="col-md-6">
			<Card>
				<CardHeader title="Sample card" />
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader title="Card with action">
					<div class="card-actions">
						<Button color="primary" icon="plus" text="Add new" />
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader title="Cart title">
					<div class="card-actions">
						<Button icon="phone" text="Phone" />
						<Button icon="mail" text="Email" />
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader>
					<div>
						<div class="row align-items-center">
							<div class="col-auto">
								<Avatar person={person0} />
							</div>
							<div class="col">
								<div class="card-title">{person0.full_name}</div>
								<div class="card-subtitle">{person0.job_title}</div>
							</div>
						</div>
					</div>
					<div class="card-actions">
						<Button icon="phone" text="Phone" />
						<Button icon="mail" text="Email" />
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader>
					<div>
						<CardTitle>
							With description
						</CardTitle>
						<p class="card-subtitle">
							Lorem ipsum dolor sit amet consectetur adipisicing.
						</p>
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader>
					<div>
						<CardTitle>
							With description and action
						</CardTitle>
						<p class="card-subtitle">
							Lorem ipsum dolor sit amet consectetur adipisicing.
						</p>
					</div>
					<div class="card-actions">
						<Button color="primary" text="Create new job" />
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader>
					<div>
						<div class="row align-items-center">
							<div class="col-auto">
								<Avatar person={person3} />
							</div>
							<div class="col">
								<div class="card-title">{person3.full_name}</div>
								<div class="card-subtitle">{person3.job_title}</div>
							</div>
						</div>
					</div>
					<div class="card-actions">
						<div class="dropdown">
							<a href="#" class="btn-action dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><Icon name="dots-vertical" /></a>
							<div class="dropdown-menu dropdown-menu-end">
								<a class="dropdown-item" href="#">Edit user</a>
								<a class="dropdown-item" href="#">Change permissions</a>
								<a class="dropdown-item text-danger" href="#">Delete user</a>
							</div>
						</div>
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>

		<div class="col-md-6">
			<Card>
				<CardHeader title="Card actions">
					<div class="card-actions btn-actions">
						<a href="#" class="btn-action"><Icon name="refresh" /></a>
						<a href="#" class="btn-action"><Icon name="chevron-up" /></a>
						<a href="#" class="btn-action"><Icon name="dots-vertical" /></a>
						<a href="#" class="btn-action"><Icon name="x" /></a>
					</div>
				</CardHeader>
				<BodyPlaceholder />
			</Card>
		</div>
	</div>
</DefaultLayout>
