---

<DefaultLayout title="Web Analytics" description="Traffic, caching and performance of your sites over the last 24 hours." pageMenu="dashboards.analytics" pageLibs={['apexcharts']}>
  <div class="row row-cards">
    {
      stats.map((stat) => (
        <div class="col-sm-6 col-lg-4 col-xl-2">
          <Card>
            <CardBody>
              <Subheader as="h2">{stat.title}</Subheader>
              <div class="d-flex align-items-baseline">
                <div class="h2 mb-0 me-2">{stat.value}</div>
                <Trending value={stat.change} />
              </div>
            </CardBody>
            <Chart chartId={stat.chart} size="sm" class="rounded-bottom-3" label={`${stat.title} over the last 24 hours`} />
          </Card>
        </div>
      ))
    }

    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Requests over time">
          <div class="card-actions d-flex align-items-center gap-2">
            <label for="requests-group-by" class="form-label mb-0 text-secondary">Group by</label>
            <select id="requests-group-by" class="form-select form-select-sm w-auto">
              {groupBy.map((option) => <option>{option}</option>)}
            </select>
          </div>
        </CardHeader>
        <CardBody>
          <LegendList class="mb-3">
            <Legend color="primary" text="Requests" value="1.88M" />
          </LegendList>
          <Chart chartId="analytics-requests" height={15} label="Requests over time" />
        </CardBody>
      </Card>
    </div>
    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Data transfer">
          <div class="card-actions d-flex align-items-center gap-2">
            <label for="transfer-group-by" class="form-label mb-0 text-secondary">Group by</label>
            <select id="transfer-group-by" class="form-select form-select-sm w-auto">
              {groupBy.map((option) => <option>{option}</option>)}
            </select>
          </div>
        </CardHeader>
        <CardBody>
          <LegendList class="mb-3">
            <Legend color="primary" text="Data transfer" value="35.71 GB" />
          </LegendList>
          <Chart chartId="analytics-transfer" height={15} label="Data transfer over time" />
        </CardBody>
      </Card>
    </div>

    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Requests by status code" />
        <CardBody>
          <LegendList class="mb-3">
            {statusCodes.map((item) => <Legend color={item.color} text={item.name} value={item.value} />)}
          </LegendList>
          <Chart chartId="analytics-status-codes" height={15} label="Requests by status code" />
        </CardBody>
      </Card>
    </div>
    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Requests by cache status" />
        <CardBody>
          <LegendList class="mb-3">
            {cacheStatus.map((item) => <Legend color={item.color} text={item.name} value={item.value} />)}
          </LegendList>
          <Chart chartId="analytics-cache-status" height={15} label="Requests by cache status" />
        </CardBody>
      </Card>
    </div>

    <div class="col-lg-6">
      <Card class="h-100">
        <CardHeader title="Edge TTFB percentiles" />
        <CardBody>
          <LegendList class="mb-3">
            {ttfb.map((item) => <Legend color={item.color} text={item.name} value={item.value} unit="ms" />)}
          </LegendList>
          <Chart chartId="analytics-ttfb" height={15} label="Edge time to first byte percentiles" />
        </CardBody>
      </Card>
    </div>
    <div class="col-lg-6">
      <TopList title="Top paths" items={lists['Top paths'] ?? []} class="h-100" />
    </div>

    {
      Object.entries(lists)
        .filter(([title]) => title !== 'Top paths')
        .map(([title, items]) => (
          <div class="col-lg-6">
            <TopList title={title} items={items} class="h-100" />
          </div>
        ))
    }
  </div>
</DefaultLayout>
