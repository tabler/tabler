---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import Card from '@ui/Card.astro'
import CardBody from '@ui/CardBody.astro'
import CardTitle from '@ui/CardTitle.astro'
---

<DefaultLayout title="Layout playground" pretitle="Playground" navbarPosition="vertical">
  <div class="row row-cards">
    <div class="col-12">
      <Card>
        <CardBody>
          <CardTitle>Sandbox</CardTitle>
          <p class="text-secondary mb-0">Edit this page to try layout options, components, and styles.</p>
        </CardBody>
      </Card>
    </div>
  </div>
</DefaultLayout>
