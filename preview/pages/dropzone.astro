---
import DefaultLayout from '@shared/layouts/DefaultLayout.astro'
import Dropzone from '@ui/Dropzone.astro'
import Card from '@ui/Card.astro'
import CardBody from '@ui/CardBody.astro'
import CardTitle from '@ui/CardTitle.astro'
import DocsLink from '@ui/DocsLink.astro'
---

<DefaultLayout title="Dropzone" pageMenu="plugins.dropzone" pageLibs={['dropzone']}>
  <DocsLink slot="page-header-actions" path="/ui/components/dropzone" />
  <div class="row row-cards">
    <div class="col-md-6">
      <Card>
        <CardBody>
          <CardTitle>Basic Usage</CardTitle>
          <Dropzone id="default" />
        </CardBody>
      </Card>
    </div>
    <div class="col-md-6">
      <Card>
        <CardBody>
          <CardTitle>Multiple File Upload</CardTitle>
          <Dropzone id="multiple" multiple={true} />
        </CardBody>
      </Card>
    </div>
    <div class="col-md-6">
      <Card>
        <CardBody>
          <CardTitle>Custom Dropzone</CardTitle>
          <Dropzone id="custom" custom={true} text="Your text here" description="Your custom description here" />
        </CardBody>
      </Card>
    </div>
  </div>
</DefaultLayout>
