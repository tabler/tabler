---
// Port of ui/breadcrumb.html.
import Icon from '../Icon.astro';

interface Props {
	/** comma-separated list of pages (Liquid `pages` param) */
	pages?: string;
	class?: string;
	/** breadcrumb-{separator} class, e.g. "dots" */
	separator?: string;
	/** first item becomes a home-icon link (home-icon param) */
	homeIcon?: boolean;
}

const { pages = 'Home,Library,Data', class: className, separator, homeIcon } = Astro.props;

// LiquidJS split behaves like Ruby's String#split: trailing empty strings are
// dropped (layout/header-actions/breadcrumb.html passes "Tabler,Pages,").
const items = pages.split(',');
while (items.length > 0 && items[items.length - 1] === '') items.pop();

const classes = [
	'breadcrumb',
	className,
	separator && `breadcrumb-${separator}`,
]
	.filter(Boolean)
	.join(' ');
---

<!-- BEGIN BREADCRUMB -->
<nav aria-label="Breadcrumb">
	<ol class={classes}>
		{
			items.map((page, index) =>
				index === items.length - 1 ? (
					<li class="breadcrumb-item active" aria-current="page">
						{page}
					</li>
				) : (
					<li class="breadcrumb-item">
						{index === 0 && homeIcon ? (
							/* Liquid: href="{{ site.baseurl }}/" — site.baseurl is undefined in Eleventy → "/" */
							<a href="/">
								<Icon name="home" />
							</a>
						) : (
							<a href="#">{page}</a>
						)}
					</li>
				),
			)
		}
	</ol>
</nav>
<!-- END BREADCRUMB -->
