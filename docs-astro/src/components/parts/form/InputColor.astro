---
import colors from '../../../data/colors.json';

interface Props {
	label?: string;
	name?: string;
	type?: 'radio' | 'checkbox';
	rounded?: boolean;
}

const { label = 'Color Input', name = 'color', type = 'radio', rounded = false } = Astro.props;

const colorsList = ['dark', 'white', ...colors.base.map((color) => color.name)];
---

<div class="mb-3">
	<label class="form-label">{ label }</label>
	<div class="row g-2">
		{colorsList.map((color, i) => (
			<div class="col-auto">
				<label class={`form-colorinput${ color == 'white' ? ' form-colorinput-light' : ''}`}>
					<input name={name} type={type} value={color} class="form-colorinput-input" checked={i == 2}/>
					<span class={`form-colorinput-color bg-${color}${ rounded ? ' rounded-circle' : ''}`}></span>
				</label>
			</div>
		))}
	</div>
</div>
