---
// Fetches this page's Markdown mirror (its url with ".md" appended) and copies
// its content to the clipboard, so the page can be pasted into an LLM directly.
import Icon from '@ui/Icon.astro'

interface Props {
  /** Url of the page's `.md` mirror, fetched on click. */
  url: string
  /** Absolute url of the same `.md` mirror, for links ChatGPT must resolve on its own. */
  absoluteUrl?: string | undefined
  class?: string
}

const { url, absoluteUrl, class: className } = Astro.props

// ChatGPT opens with this text already in the composer; the reader still has to press send.
const askChatGptUrl = absoluteUrl && `https://chatgpt.com/?q=${encodeURIComponent(`Read ${absoluteUrl} so I can ask questions about it.`)}`
---

<div class="btn-group">
  <button type="button" class:list={['btn btn-sm', className]} data-docs-copy-markdown-link={url}>
    <Icon name="clipboard" />
    <Icon name="check" class="d-none" />
    <span data-docs-copy-markdown-link-label>Copy to LLM</span>
  </button>
  <button type="button" class="btn btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
    <span class="visually-hidden">Toggle dropdown</span>
  </button>
  <div class="dropdown-menu dropdown-menu-end">
    <a class="dropdown-item" href={url} target="_blank">
      <Icon name="external-link" />
      <span>View as markdown</span>
    </a>
    {
      askChatGptUrl && (
        <a class="dropdown-item" href={askChatGptUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="brand-openai" />
          <span>Ask ChatGPT</span>
        </a>
      )
    }
  </div>
</div>

<script>
  // Several buttons can share this markup on one page (header, sidebar, …),
  // so wire all of them and derive each one's url from its own attribute.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-docs-copy-markdown-link]')

  buttons.forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-docs-copy-markdown-link-label]')
    const [clipboardIcon, checkIcon] = button.querySelectorAll<HTMLElement>('svg')

    button.addEventListener('click', async () => {
      const url = button.dataset.docsCopyMarkdownLink
      if (!url || !label) return

      try {
        const response = await fetch(url)
        await navigator.clipboard.writeText(await response.text())

        const original = label.textContent
        label.textContent = 'Copied'
        clipboardIcon?.classList.add('d-none')
        checkIcon?.classList.remove('d-none')

        setTimeout(() => {
          label.textContent = original
          clipboardIcon?.classList.remove('d-none')
          checkIcon?.classList.add('d-none')
        }, 2000)
      } catch {
        // clipboard permission refused — leave the label alone
      }
    })
  })
</script>
