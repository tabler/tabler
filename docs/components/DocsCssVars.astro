---
// The "CSS" section of a component page, built like the Bootstrap docs: the
// custom-property block and the Sass defaults, both cut from the sources by
// lib/scss-docs.ts. Either part may be missing.
import CodeSnippet from '@components/CodeSnippet.astro'
import { cssSection } from '@lib/scss-docs'
import { site } from '@shared/lib/site'

interface Props {
  /** the custom-property family after `--`, e.g. `badge` for the `badge-css-vars` marker */
  cssVars?: string | string[] | undefined
  /** the `<name>-variables` marker in `_variables.scss`; defaults to `cssVars` */
  sassVars?: string | string[] | undefined
}

const { cssVars, sassVars } = Astro.props
const { css, sass } = await cssSection(cssVars, sassVars)

const fileLink = (path: string) => `${site.githubUrl}/blob/dev/${path}`
---

<!-- BEGIN DOCS CSS VARS -->{
  (css.length > 0 || sass.length > 0) && (
    <Fragment>
      <h2 id="css">CSS</h2>

      {css.length > 0 && (
        <Fragment>
          <h3 id="css-variables">Variables</h3>
          <p>The component uses local CSS variables for real-time customization. Values for the CSS variables are set via Sass, so Sass customization is still supported, too.</p>
          {css.map((block) => (
            <Fragment>
              <p>
                {block.selector ? (
                  <Fragment>
                    On <code>{block.selector}</code>. Source:{' '}
                  </Fragment>
                ) : (
                  'Source: '
                )}
                <a href={fileLink(block.path)}>
                  <code>{block.path}</code>
                </a>
                .
              </p>
              <CodeSnippet code={block.code} lang="scss" />
            </Fragment>
          ))}
        </Fragment>
      )}

      {sass.length > 0 && (
        <Fragment>
          <h3 id="sass-variables">Sass variables</h3>
          <p>Override these variables before importing Tabler to change the defaults.</p>
          {sass.map((block) => (
            <Fragment>
              <p>
                Source:{' '}
                <a href={fileLink(block.path)}>
                  <code>{block.path}</code>
                </a>
                .
              </p>
              <CodeSnippet code={block.code} lang="scss" />
            </Fragment>
          ))}
        </Fragment>
      )}
    </Fragment>
  )
}
<!-- END DOCS CSS VARS -->
