{
  "name": "@tabler/docs",
  "private": true,
  "type": "module",
  "version": "1.7.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run css && concurrently -n astro,css -c blue,magenta \"astro dev\" \"pnpm run watch:css\"",
    "build": "pnpm run css && astro build",
    "css": "tsx ../.build/build-css.ts scss tmp-assets/css --minify --no-prefix",
    "watch:css": "nodemon --watch scss/ --ext scss --exec \"tsx ../.build/build-css.ts scss tmp-assets/css --no-prefix\"",
    "preview": "astro preview",
    "clean": "shx rm -rf dist public .astro tmp-assets",
    "type-check": "astro check"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.17",
    "@docsearch/js": "^5.2.0",
    "@tabler/core": "workspace:*",
    "@vercel/functions": "^3.10.5",
    "astro": "^7.4.4",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^7.0.8",
    "@docsearch/css": "^5.2.0",
    "@tabler/preview": "workspace:*",
    "@types/node": "^26.6.6",
    "js-beautify": "^2.0.3",
    "sharp": "^0.35.5",
    "shx": "^0.4.0",
    "typescript": "^6.0.3"
  }
}
