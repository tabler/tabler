{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "public",
    "assets"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@data/*": [
        "../shared/data/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      "@ui/*": [
        "../shared/ui/*"
      ],
      "@components/*": [
        "./components/*"
      ],
      "@layouts/*": [
        "./layouts/*"
      ]
    }
  }
}
