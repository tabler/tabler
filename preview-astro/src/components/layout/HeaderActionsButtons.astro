---
// Port of layout/header-actions/buttons.html.
// TODO: the layout-navbar-overlap && layout-navbar-dark branch (the "New view"
// button with color="dark") — unused on the homepage (both unset).
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import Modal from '../modals/Modal.astro';
import ReportModalContent from '../modals/ReportModalContent.astro';
---

<div class="btn-list">
	<span class="d-none d-sm-inline">
		<Button text="New view" />
	</span>
	{/* Button.astro doesn't support modal-id (data-bs-toggle/target), so these two
	    buttons are reproduced directly from the ui/button.html output. */}
	<a
		href="#"
		class="btn btn-primary d-none d-sm-inline-block"
		data-bs-toggle="modal"
		data-bs-target="#modal-report"
	>
		<Icon name="plus" />
		Create new report
	</a>
	<a
		href="#"
		class="btn btn-primary d-sm-none btn-icon"
		data-bs-toggle="modal"
		data-bs-target="#modal-report"
		aria-label="Create new report"
	>
		<Icon name="plus" />
	</a>
</div>

<!-- BEGIN MODAL -->
<Modal modalId="report" size="lg" top>
	<ReportModalContent />
</Modal>
<!-- END MODAL -->
