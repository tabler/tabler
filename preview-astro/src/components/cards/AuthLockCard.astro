---
// Equivalent of cards/auth-lock.html
import Button from '../Button.astro';
import Avatar from '../ui/Avatar.astro';
import people from '@data/people.json';

const person = people[0];
---

<form class="card card-md" action="./" method="get" autocomplete="off" novalidate>
	<div class="card-body text-center">
		<div class="mb-4">
			<h2 class="card-title">Account Locked</h2>
			<p class="text-secondary">Please enter your password to unlock your account</p>
		</div>

		<div class="mb-4">
			<Avatar person={person} size="xl" class="mb-3" />
			<h3>{person.full_name}</h3>
		</div>

		<div class="mb-4">
			<input type="password" class="form-control" placeholder="Password&hellip;" />
		</div>

		<div>
			<Button color="primary" block icon="lock-open" text="Unlock" />
		</div>
	</div>
</form>
