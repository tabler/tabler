---
// Package-specific script emission point — the one deliberate divergence between
// preview-astro and docs-astro in otherwise identical shared components.
//
// preview-astro mirrors Eleventy's {% capture_script %} model: components register
// their <script> via addPageScript() and <PageScripts /> drains them at the end of
// <body>, so this component intentionally renders NOTHING here.
// (docs-astro's counterpart renders the script inline instead — the Eleventy docs
// layout has no {% scripts %} drain; example scripts are part of the example markup.)
interface Props {
	code: string;
}
