---
// Port of preview/pages/icons.html (layout: default)
import DefaultLayout from '../layouts/DefaultLayout.astro';
import IconsBanner from '../components/cards/IconsBanner.astro';
import Icons from '../components/cards/Icons.astro';
---

<DefaultLayout title="Icons" pageHeader="Icons" pageMenu="addons.icons">
	<div class="row row-cards">
		<div class="col-lg-4">
			<IconsBanner />
		</div>
		<div class="col">
			<div class="row row-cards">
				<div class="col-12">
					<Icons title="Interface icons" type="outline" />
				</div>
				<div class="col-12">
					<Icons title="Filled icons" type="filled" />
				</div>
			</div>
		</div>
	</div>
</DefaultLayout>
