---
// Port of preview/pages/pagination.html (layout: default)
import DefaultLayout from '../layouts/DefaultLayout.astro';
import Pagination from '../components/ui/Pagination.astro';
---

<DefaultLayout title="Pagination" pageHeader="Pagination" pageMenu="base.pagination">
	<div class="row row-cards">
		<div class="col-12">
			<div class="card">
				<div class="card-body">
					<Pagination />
					<Pagination text />
				</div>
			</div>
		</div>
		<div class="col-12">
			<div class="card">
				<div class="card-body">
					<Pagination count={0} prevDescription="Getting started" nextDescription="Breadcrumbs" />
				</div>
			</div>
		</div>
	</div>
</DefaultLayout>
