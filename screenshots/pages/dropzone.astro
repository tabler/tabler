---
// Dropzone in the middle of its job: an attachments card with the drop area on
// top and three files below it — one uploaded, one on its way and one rejected
// for its size. The rows are written by hand in the markup the plugin builds,
// because a capture cannot pick files or reach an upload endpoint.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import Card from '@ui/Card.astro'
import CardBody from '@ui/CardBody.astro'
import CardTitle from '@ui/CardTitle.astro'
import CardSubtitle from '@ui/CardSubtitle.astro'
import Dropzone from '@ui/Dropzone.astro'
import DropzoneItem from '@ui/DropzoneItem.astro'
---

<ScreenshotLayout title="Dropzone" columns={2}>
  <Card>
    <CardBody class="p-4">
      <CardTitle>Attachments</CardTitle>
      <CardSubtitle>Add the files that go with this invoice.</CardSubtitle>
      <Dropzone id="shot-dropzone" name="attachments" multiple description="PNG, JPG or PDF, up to 5 MB">
        <DropzoneItem title="office-desk.jpg" description="1.8 MB" status="success" value={100} />
        <DropzoneItem title="invoice-2025-014.pdf" description="3.4 MB" status="uploading" value={62} />
        <DropzoneItem title="product-walkthrough.mp4" description="File is too large (max 5 MB)" status="error" />
      </Dropzone>
    </CardBody>
  </Card>
</ScreenshotLayout>
