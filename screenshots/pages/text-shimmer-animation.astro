---
// Text shimmer for the video recorder (`pnpm run record text-shimmer-animation`):
// one "Thinking…" label with its loader, nothing else, zoomed in so the
// fade-in, the spinner and the sweeping highlight fill the frame.
// steps/text-shimmer-animation.json only waits, long enough for the fade-in
// and two full sweeps. Without ?motion the layout freezes the animation.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import TextShimmer from '@ui/TextShimmer.astro'
---

<ScreenshotLayout title="Text shimmer animation" zoom={2} showLogo={false}>
  <div class="text-center">
    <TextShimmer loader live>Thinking…</TextShimmer>
  </div>
</ScreenshotLayout>
