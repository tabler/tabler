---
// The combined navigation position (`data-bs-navbar-position="combined"`): the
// vertical sidebar and the top navbar on screen at once, instead of one hiding
// the other.
import ScreenshotAppLayout from '../layouts/ScreenshotAppLayout.astro'
import CrmDashboard from '../components/CrmDashboard.astro'
---

<ScreenshotAppLayout title="Combined layout" pageHeader="CRM Dashboard" description="Welcome back — here's your CRM overview for today." pageMenu="dashboards.crm" navbarPosition="combined" pageLibs={['apexcharts']}>
  <CrmDashboard />
</ScreenshotAppLayout>
