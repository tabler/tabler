---
// The vector map with markers and the dashed lines between them: places set
// by latitude and longitude, joined by name.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import MapVector from '@components/demo/MapVector.astro'
---

<ScreenshotLayout title="Map routes" columns={2} pageLibs={['vector-map']}>
  <div class="card">
    <div class="card-body">
      <h3 class="card-title">Connections</h3>
      <MapVector mapId="world-lines" />
    </div>
  </div>
</ScreenshotLayout>
