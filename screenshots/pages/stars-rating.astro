---
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import Rating from '@ui/Rating.astro'
---

<ScreenshotLayout title="Star rating" columns={2}>
  <div class="space-y">
    <div>
      <div class="text-secondary mb-2">Basic</div>
      <Rating id="screenshot-basic" value={4} />
    </div>
    <div>
      <div class="text-secondary mb-2">Half stars</div>
      <Rating id="screenshot-half" value={3.5} half />
    </div>
    <div>
      <div class="text-secondary mb-2">Readonly</div>
      <Rating id="screenshot-readonly" value={3.7} readonly />
    </div>
  </div>
</ScreenshotLayout>
