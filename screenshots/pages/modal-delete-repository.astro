---
// The Delete repository modal — a destructive confirmation that asks for the
// repository name before the delete button turns on. Rendered inline
// (ModalInline + `show`) so a static capture shows the open dialog, with the name
// already typed in so the picture shows the armed state.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import ModalInline from '@shared/components/modals/ModalInline.astro'
import DeleteRepositoryModalContent from '@shared/components/modals/DeleteRepositoryModalContent.astro'
---

<ScreenshotLayout title="Delete repository modal" columns={2}>
  <ModalInline class="position-relative rounded d-block w-auto h-auto z-0" modalId="delete-repository" show>
    <DeleteRepositoryModalContent />
  </ModalInline>
  <!-- An empty field leaves the delete button off, so type the name in and let the
  modal's own `input` handler enable it. -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('delete-repository-input')
      if (!input) return
      input.value = input.dataset.repository
      input.dispatchEvent(new Event('input', { bubbles: true }))
    })
  </script>
</ScreenshotLayout>
