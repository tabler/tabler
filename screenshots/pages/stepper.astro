---
// Stepper on its own: a quantity field between its two buttons, with the
// cursor resting on the increase button. The value sits below the maximum, so
// both buttons stay enabled and the picture shows the control in its normal
// state rather than at a bound.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import Stepper from '@ui/Stepper.astro'
---

<ScreenshotLayout title="Stepper" zoom={2} class="text-center">
  <div class="d-inline-block position-relative">
    <Stepper value={3} min={1} max={99} ariaLabel="Quantity" />
    <span class="cursor" style="left: auto; right: 6px; top: 22px"></span>
  </div>
</ScreenshotLayout>
