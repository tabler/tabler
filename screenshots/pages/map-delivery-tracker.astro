---
// Delivery tracker block: a map with the route of a delivery, solid where the
// courier has been and dashed ahead, the courier and the destination as
// markers, and the order status in a card over the map.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'
import MapPalette from '@components/demo/MapPalette.astro'
import MapDeliveryTracker from '@components/cards/MapDeliveryTracker.astro'
---

<ScreenshotLayout title="Map: delivery tracker" columns={1.8} pageLibs={['maplibre-gl']}>
  <MapPalette />
  <MapDeliveryTracker />
</ScreenshotLayout>
