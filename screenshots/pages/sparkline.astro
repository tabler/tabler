---
// Sparkline component on its own: a grid of the chart types — a plain line, a
// filled line with the last value marked, bars and a circle — colored in
// palette order (blue → green), since the charts draw with currentColor. The
// charts use the `sparkline-lg` size (and `sparkline-square` for the circles)
// with a thicker stroke so they read at picture size.
import ScreenshotLayout from '../layouts/ScreenshotLayout.astro'

const charts = [
  { color: 'blue', type: 'line', values: '14,9,17,11,22,8,19,13,24,16,10,21' },
  { color: 'azure', type: 'line', fill: 'auto', spot: 'last', values: '7,15,11,23,9,18,26,14,20,12,29,33' },
  { color: 'indigo', type: 'bar', values: '5,12,8,3,14,9,6,15,4,11' },
  { color: 'purple', type: 'circle', values: '64' },
  { color: 'pink', type: 'line', spot: 'max', values: '21,13,27,18,9,31,15,24,12,19,26,17' },
  { color: 'orange', type: 'line', fill: 'auto', spot: 'min', values: '38,29,34,17,25,11,22,15,8,19,13,16' },
  { color: 'teal', type: 'bar', values: '11,4,13,7,2,9,14,6,10,3' },
  { color: 'green', type: 'circle', values: '27' },
]

const isCircle = (type: string) => type === 'circle'
---

<ScreenshotLayout title="Sparkline" columns={2.4}>
  <div class="d-grid gap-6 justify-content-center align-items-center" style="grid-template-columns: repeat(4, auto)">
    {
      charts.map((chart) => (
        <span
          class:list={['sparkline', 'sparkline-lg', isCircle(chart.type) && 'sparkline-square', `text-${chart.color}`]}
          style={isCircle(chart.type) ? '--tblr-sparkline-stroke-width: 4' : '--tblr-sparkline-stroke-width: 2.5; --tblr-sparkline-spot-size: 3'}
          data-bs-toggle="sparkline"
          data-bs-type={chart.type}
          data-bs-fill={chart.fill}
          data-bs-spot={chart.spot}
          data-bs-values={chart.values}
          data-bs-max={isCircle(chart.type) ? 100 : undefined}
          data-bs-width={isCircle(chart.type) ? 40 : 120}
          data-bs-height={isCircle(chart.type) ? 40 : 40}
          data-bs-pad={isCircle(chart.type) ? undefined : 3}
          data-bs-bar-gap={chart.type === 'bar' ? 4 : undefined}
          data-bs-bar-radius={chart.type === 'bar' ? 3 : undefined}
          aria-label={`${chart.type} sparkline`}
        />
      ))
    }
  </div>
</ScreenshotLayout>
